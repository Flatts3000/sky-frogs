{
  // A list of biomes for each dimension.
  // You can not use this for the end dimension. The end dimension will always have it's five biomes.
  // Overworld has all oceans by default because animals cannot spawn in these biomes.
  // A list of biomes will be generated at "config/skyblockbuilder/data/biomes.txt" each time joining a world.
  // These are resource lists. See https://moddingx.org/libx/org/moddingx/libx/util/data/ResourceList.html#use_resource_lists_in_configs
  //
  // SKY FROGS: the overworld is forced to a single swamp biome. This is load-bearing for Tier 1.
  // The pack disables all six PF default spawns and re-adds the Cave Slime (the Tier 1 starter
  // species) to minecraft:swamp via kubejs/data/skyfrogs/.../add_cave_slime_island.json (weight 200).
  // Cave Slime is a MONSTER with PF's light-based placement rule, so a dark-room farm on the swamp
  // island produces Cave Slimes. Swamp is also on-theme for a frog pack.
  // NOTE: this only works if SkyblockBuilder spawn protection is off near origin - see
  // config/skyblockbuilder/spawn.json5 (spawnProtectionRadius = 0). At the default radius the
  // `mobs_spawn` protection suppresses spawns on the starter island. See docs/worldgen.md +
  // docs/kubejs_overrides.md Pillar 2.
  "biomes": {
    "minecraft:overworld": {
      "allow_list": true,
      "elements": [
        "minecraft:swamp"
      ]
    },
    "minecraft:the_nether": {
      "allow_list": false,
      "elements": []
    }
  },

  // A list of carvers for each dimension.
  // A list of carvers will be generated at "config/skyblockbuilder/data/carvers.txt" each time joining a world.
  // These are resource lists. See https://moddingx.org/libx/org/moddingx/libx/util/data/ResourceList.html#use_resource_lists_in_configs
  "carvers": {
    "minecraft:overworld": {
      "allow_list": true,
      "elements": []
    },
    "minecraft:the_nether": {
      "allow_list": true,
      "elements": []
    },
    "minecraft:the_end": {
      "allow_list": true,
      "elements": []
    }
  },

  // Distance between islands in overworld [default: 8192]
  // Range: 64 - 29999900
  "islandDistance": 8192,

  // If a player is leaving a team, it will teleported to overworld spawn instead of spawn island.
  "leaveToOverworld": false,

  // Prevent scheduled ticks after generating the island
  "preventScheduledTicks": true,

  // Sea level in world [default: 63]
  "seaHeight": 63,

  // Should a surface be generated in the dimensions? [default: false]
  "surface": false,

  // The block settings for generating the different dimensions surfaces.
  // Same format as flat world generation settings (blocks only).
  // NOTE: inert while "surface": false above - SkyblockBuilder ignores this block
  // unless surface generation is enabled. Kept at defaults in case it's flipped on.
  "surfaceSettings": {
    "minecraft:overworld": [
      {
        "block": "minecraft:bedrock"
      },
      {
        "block": "minecraft:dirt",
        "height": 2
      },
      {
        "block": "minecraft:grass_block"
      }
    ],
    "minecraft:the_nether": [],
    "minecraft:the_end": []
  }
}
