	quest.70DDCDB366848F36.title: "Blazegold (Just Dire Things)"
	quest.70DDAAEA0EA55AAA.title: "Celestigem (Just Dire Things)"
	quest.70DDE576AB2A4D82.title: "Eclipsealloy (Just Dire Things)"
	quest.70DDC713FC1F7A30.title: "Blaze Ember (Just Dire Things)"
	quest.70DD39115A47C69E.title: "Voidflame (Just Dire Things)"
	quest.70DD37EF0BD0D556.title: "Eclipse Ember (Just Dire Things)"
	quest.70DD831A136C804F.quest_desc: [
		"Every modded resource the loaded mods taught your frogs - one column per neighbor. The sister ponds send their regards."
	]
	quest.70DD831A136C804F.quest_subtitle: "Diplomacy, by froglight."
	quest.70DD831A136C804F.title: "Sister Ponds"
	chapter.70DD000000000001.title: "Sister Ponds"
	quest.7CA7E000C0DE0026.quest_desc: [
		"A &fbreeze rod&r without a trial chamber in sight - the Cave frog farms what the Breeze drops, wind charges and all."
		""
		"Turn in the &bBreeze Rod Froglight&r."
	]
	quest.7CA7E000C0DE0026.quest_subtitle: "Catch the wind."
	quest.7CA7E000C0DE0026.title: "Breeze Rod"
	quest.7D00000000000029.quest_desc: [
		"&aTurtle scutes&r without the beach nursery - no eggs, no babies, no waiting. The Tide frog skips the whole life cycle."
		""
		"Turn in the &bTurtle Scute Froglight&r."
	]
	quest.7D00000000000029.quest_subtitle: "Shell, expedited."
	quest.7D00000000000029.title: "Turtle Scute"
	quest.51F000000000001E.quest_desc: [
		"&fGhast tears&r - regeneration potions and End crystals - without crying over a fireball. The Infernal frog weeps them on demand."
		""
		"Turn in the &bGhast Tear Froglight&r."
	]
	quest.51F000000000001E.quest_subtitle: "No tissue required."
	quest.51F000000000001E.title: "Ghast Tear"
	quest.60F0000000000014.quest_desc: [
		"&dPhantom membranes&r - slow falling and elytra repair - without ever skipping a night's sleep. The Void frog handles the insomnia."
		""
		"Turn in the &bPhantom Membrane Froglight&r."
	]
	quest.60F0000000000014.quest_subtitle: "Sleep well anyway."
	quest.60F0000000000014.title: "Phantom Membrane"
	quest.7B06000000000022.quest_desc: [
		"&6Armadillo scutes&r - wolf armor - from a frog instead of a brush. The Bog covers the savanna's job."
		""
		"Turn in the &bArmadillo Scute Froglight&r."
	]
	quest.7B06000000000022.quest_subtitle: "Roll with it."
	quest.7B06000000000022.title: "Armadillo Scute"
	quest.7B06000000000025.quest_desc: [
		"&eHoneycomb&r - waxed copper, hives, candles - with zero bees bothered. The Bog frog is the apiary now."
		""
		"Turn in the &bHoneycomb Froglight&r."
	]
	quest.7B06000000000025.quest_subtitle: "Unbeelievable."
	quest.7B06000000000025.title: "Honeycomb"
	quest.7B06000000000028.quest_desc: [
		"&fBones&r - bone meal, bone blocks, and every wolf's undying loyalty - without a single skeleton seeing sunrise. The Bog frog supplies the orthopedics."
		""
		"Turn in the &bBone Froglight&r."
	]
	quest.7B06000000000028.quest_subtitle: "Dem dry bones."
	quest.7B06000000000028.title: "Bone"
	quest.7B0600000000002B.quest_desc: [
		"&7Gunpowder&r - TNT, fireworks, rockets for the elytra you will eventually earn - and not one creeper consulted. The Bog frog is the powder keg."
		""
		"Turn in the &bGunpowder Froglight&r."
	]
	quest.7B0600000000002B.quest_subtitle: "Boom, sorted."
	quest.7B0600000000002B.title: "Gunpowder"
	quest.7B0600000000002E.quest_desc: [
		"&2Rotten flesh&r - cleric trade fodder and emergency rations you will regret. Some resources are about volume, not glamour; the frogs do not judge."
		""
		"Turn in the &bRotten Flesh Froglight&r."
	]
	quest.7B0600000000002E.quest_subtitle: "It's a living."
	quest.7B0600000000002E.title: "Rotten Flesh"
	quest.7B06000000000031.quest_desc: [
		"&fString&r - bows, fishing rods, scaffolding, wool four-at-a-time - no spider, no cave, no ceiling ambush. The Bog frog spins it on demand."
		""
		"Turn in the &bString Froglight&r."
	]
	quest.7B06000000000031.quest_subtitle: "No strings attached."
	quest.7B06000000000031.title: "String"
	quest.51F0000000000021.quest_desc: [
		"&6Magma cream&r - fire resistance potions and magma blocks - without bothering a single magma cube. Pairs beautifully with a tier built on lava."
		""
		"Turn in the &bMagma Cream Froglight&r."
	]
	quest.51F0000000000021.quest_subtitle: "Slippery when hot."
	quest.51F0000000000021.title: "Magma Cream"
	quest.51F0000000000024.quest_desc: [
		"Brew a &dsplash&r or &dlingering potion&r and throw it at a slime - any slime - before its frog eats it. The Froglight that drops &dcaptures the effect&r. Place it and right-click to toggle: while the aura is on, everything in range gets the effect, good or bad - a &aRegeneration&r room heals you, a &cPoison&r perimeter greets your guests. Held in hand, it buffs just you."
		""
		"Blaze rods from the frog, nether wart on frog-made soul sand: the brewing stand was already yours. This one is on the honor system - check the box once you have bottled your first aura."
	]
	quest.51F0000000000024.quest_subtitle: "The frog sommelier."
	quest.51F0000000000024.title: "Pop the Cork"
	quest.51F0000000000027.quest_desc: [
		"With Curios installed, a brewed Froglight rides a dedicated &dFroglight charm slot&r and buffs you while worn - the aura without giving up a hand or a hotbar slot. One light, one slot, always on."
		""
		"Honor system again: check the box once you are wearing the weather."
	]
	quest.51F0000000000027.quest_subtitle: "Wearable weather."
	quest.51F0000000000027.title: "Charmed, I'm Sure"
	quest.7807000000000029.quest_desc: [
		"Every farm in this chapter runs on &5boss Slime Milk&r - and boss milk is &ctoxic&r. Stand in a boss milk pool and the &cWither&r takes you, trophies or not. The slimes bathe in it. The frogs wade through it. You cannot."
		""
		"The cure is &5containment&r: each boss's &ecatalyst blocks&r, crafted from the boss's own substance, entomb the milk behind all six of its faces. Sealed, the poison works FOR you - the pool spawns slimes on its own and cannot reach you. Unsealed, it is just a hazard; the farm will not even run. Until the sixth face is on, keep your distance."
		""
		"Check the box once you have made peace with this."
	]
	quest.7807000000000029.quest_subtitle: "The pond bites back."
	quest.7807000000000029.title: "Do Not Touch the Milk"
	quest.7807000000000002.quest_desc: [
		"The frogs have learned &5boss farming&r, and every boss farm is built the same way: the toxic milk gets &5entombed&r in six &ecatalyst blocks&r of the boss's own substance, one against each face - contained, it spawns slimes for you instead of Withering you. Start at the fortress: &fwither skeletons&r drop skulls. Show me &eone&r; the other six go straight into the containment. (The jetpack helps. The Mace helps more.)"
		""
		"Eight soul sand around a skull makes one &eWither Skeleton Skull Catalyst&r - craft six. Place a source of Skull Slime Milk and seal a catalyst against each of its six faces. Mouse over the milk - Jade shows the face count."
	]
	quest.7807000000000002.quest_subtitle: "Heads will roll."
	quest.7807000000000002.title: "Skull Harvest"
	quest.7807000000000005.quest_desc: [
		"Seal a Skull Slime Milk source inside its six catalysts and the tomb comes alive: Skull Slimes rising out of milk that can no longer touch you, frogs queuing at the rim. The poison is still in there. That is the point."
		""
		"Turn in the &bWither Skeleton Skull Froglight&r."
	]
	quest.7807000000000005.quest_subtitle: "The bone orchard."
	quest.7807000000000005.title: "Wither Skeleton Skull"
	quest.7807000000000008.quest_desc: [
		"Three skulls and four soul sand summon the &5Wither&r - and your altar grows both. Build it somewhere you do not love, put it down, take the &fNether Star&r. Show me &eone star&r - then do it six more times, because eight obsidian around each makes the &esix Nether Star Catalysts&r the next altar wants. The first beacon is on you."
	]
	quest.7807000000000008.quest_subtitle: "You built this fight from scratch. Six times."
	quest.7807000000000008.title: "The Withering"
	quest.780700000000000B.quest_desc: [
		"The star pool shines like a beacon through its obsidian containment - and only those six catalysts keep it from killing you faster than any of the six Withers that fed it. Watch the frogs manufacture the rarest drop in the game from the safe side of the seal."
		""
		"Turn in the &bNether Star Froglight&r."
	]
	quest.780700000000000B.quest_subtitle: "Beacons, plural."
	quest.780700000000000B.title: "Nether Star"
	quest.780700000000000E.quest_desc: [
		"Vanilla law says ONE &dDragon Egg&r per world, ever. This pack repeals it: every dragon you respawn and slay lays another. Four &dEnd Crystals&r (frog-farmed ghast tears, glass, an Eye of Ender) on the portal rim bring her back; the kill drops an egg, every time. Show me &eone&r - and farm six more for the build."
		""
		"End stone bricks around each: &esix Dragon Egg Catalysts&r - the altar the world's old math could never afford."
	]
	quest.780700000000000E.quest_subtitle: "One per customer - repealed."
	quest.780700000000000E.title: "A Clutch of Eggs"
	quest.7807000000000011.quest_desc: [
		"Six eggs in end stone brick, entombing a pool of Egg Slime Milk - its &cpoison&r sealed inside the very blocks it paid for, spawning Egg Slimes on its own. The frogs do the rest."
		""
		"Turn in the &bDragon Egg Froglight&r."
	]
	quest.7807000000000011.quest_subtitle: "From one egg, a clutch."
	quest.7807000000000011.title: "Dragon Egg"
	quest.7807000000000014.quest_desc: [
		"You are respawning dragons on a schedule now anyway - this time bring &dglass bottles&r. When she breathes purple at you, catch it. Politely. Show me &eone bottle&r, fill six more, and wrap purpur around each: &esix Dragon Breath Catalysts&r."
		""
		"The catalysts hold the milk's &cpoison&r in. Keep your end of the bargain: never pry one loose while the pool is wet."
	]
	quest.7807000000000014.quest_subtitle: "CPR for dragons."
	quest.7807000000000014.title: "Breath of Fresh End"
	quest.7807000000000017.quest_desc: [
		"The dragon's exhale, mass-produced by amphibians while she sleeps it off in the End. Lingering potions forever."
		""
		"Turn in the &bDragon Breath Froglight&r."
	]
	quest.7807000000000017.quest_subtitle: "Industrial-scale exhalation."
	quest.7807000000000017.title: "Dragon Breath"
	quest.780700000000001A.quest_desc: [
		"The active-play answer to the passive pond, and the apex of the Trophy Pond: a sword that drops a Resource Slime's &bFroglight&r when it lands the kill. It hits harder than netherite, shrugs off fire, Looting raises the yield, and a brewed slime's effect carries onto the Froglight - exactly as if a frog had eaten it."
		""
		"Forged from the bosses' own light: two &bNether Star Froglights&r and a &bDragon Egg Froglight&r, wrapped in &fDragon's Breath&r. The four trophies no farm was ever supposed to produce, now bound into one blade. You are the apex."
	]
	quest.780700000000001A.quest_subtitle: "Harvest the light by hand."
	quest.780700000000001A.title: "The Froglight Cleaver"
	chapter.7807000000000001.title: "Trophy Pond"
	quest.7CA7E000C0DE0002.quest_desc: [
		"You've pulled iron out of a frog. The Cave frog handles everything else the pickaxe used to: copper, gold, coal, lapis, redstone, obsidian - and the modded metals besides."
		""
		"&7(Chapter stub - the per-resource quests land here.)&r"
	]
	quest.7CA7E000C0DE0002.quest_subtitle: "The Cave chain opens."
	quest.7CA7E000C0DE0002.title: "Beyond Iron"
	quest.7CA7E000C0DE0005.quest_desc: [
		"The first new metal off the line. Craft a &bCopper Slime in a Bucket&r from your &eiron milk&r (plus four stone, three sweetslime, and a Cave frogspawn bottle)."
		""
		"Then run the loop you already know: milk it, pour out the Copper Slime Milk, feed the slimes to a Cave Frog, and turn in the &bCopper Froglight&r it leaves. Smelt that Froglight for your copper ingot."
	]
	quest.7CA7E000C0DE0005.quest_subtitle: "The first new metal."
	quest.7CA7E000C0DE0005.title: "Copper"
	quest.7CA7E000C0DE0008.quest_desc: [
		"One rung up: &ecopper milk&r becomes a &eGold Slime in a Bucket&r."
		""
		"Same loop. Turn in the &bGold Froglight&r, then smelt it for gold."
	]
	quest.7CA7E000C0DE0008.quest_subtitle: "Shiny, soft, useful."
	quest.7CA7E000C0DE0008.title: "Gold"
	quest.7CA7E000C0DE000B.quest_desc: [
		"&6Gold milk&r this time, for a &7Coal Slime&r - fuel you can make without a single coal ore in sight."
		""
		"Turn in the &bCoal Froglight&r the frog leaves you, then smelt it for coal - fuel without an ore in sight."
	]
	quest.7CA7E000C0DE000B.quest_subtitle: "Fuel, no ore in sight."
	quest.7CA7E000C0DE000B.title: "Coal"
	quest.7CA7E000C0DE000E.quest_desc: [
		"Last of the Cave line: &bglow ink milk&r into a &cRedstone Slime&r."
		""
		"Redstone is the spark under everything mechanical, and now it drips out of a frog. Loop it, turn in the &bRedstone Froglight&r, and the Cave is yours top to bottom. Smelt the Froglight for redstone."
	]
	quest.7CA7E000C0DE000E.quest_subtitle: "The spark under everything."
	quest.7CA7E000C0DE000E.title: "Redstone"
	quest.7CA7E000C0DE0023.quest_desc: [
		"&7Coal milk&r next, for a &bGlow Ink Sac Slime&r - the deep caves' glow squids, distilled, no squid required."
		""
		"Turn in the &bGlow Ink Sac Froglight&r, then smelt it for &bglow ink sacs&r: glowing signs and item frames for the base, and one more resource the endgame will come asking about."
	]
	quest.7CA7E000C0DE0023.quest_subtitle: "Glow without the squid."
	quest.7CA7E000C0DE0023.title: "Glow Ink"
	quest.7CA7E000C0DE0020.quest_desc: [
		"A &eMob Filter&r is a solid wall to everything but one kind of thing. The &ePlayer&r filter only lets &fyou&r through, so you can seal a frog pen and still step into it - no ledge-lead needed."
		""
		"&7Dark Utilities&r ships the whole family: a &eSlime&r filter (handy when your whole economy is slimes), plus Hostile, Animal, Undead and more, each built the same way around a different center item. A &egolden pickaxe&r in the middle makes this one."
	]
	quest.7CA7E000C0DE0020.quest_subtitle: "A wall just for you."
	quest.7CA7E000C0DE0020.title: "Players Only"
	quest.7D00000000000002.quest_desc: [
		"You pulled &bprismarine&r out of the void-sea; the rest of the reef follows the same loop. Each &eTide&r resource: chamber its slime, milk it, feed a &eTide Frog&r, smelt the &bFroglight&r."
		""
		"Five more to land the full aquatic roster. Claim your reward and dive in."
	]
	quest.7D00000000000002.quest_subtitle: "The Tide chain opens."
	quest.7D00000000000002.title: "Drowned Riches"
	quest.7D00000000000005.quest_desc: ["Run the loop for &bPrismarine Crystals&r. Smelt the &bPrismarine Crystals Froglight&r into crystals - four of them around a prismarine shard make a &esea lantern&r."]
	quest.7D00000000000005.quest_subtitle: "The sea glows."
	quest.7D00000000000005.title: "Prismarine Crystals"
	quest.7D00000000000008.quest_desc: ["&bSponge&r, with no ocean monument and no guardians in sight. Smelt the &bSponge Froglight&r for a dry sponge - then soak up a puddle of the void."]
	quest.7D00000000000008.quest_subtitle: "Thirsty block."
	quest.7D00000000000008.title: "Sponge"
	quest.7D0000000000000B.quest_desc: ["&bInk Sac&r from a frog instead of a squid. Smelt the &bInk Sac Froglight&r for ink - black dye on tap, no fishing required."]
	quest.7D0000000000000B.quest_subtitle: "Squid, without the squid."
	quest.7D0000000000000B.title: "Ink Sac"
	quest.7D0000000000000E.quest_desc: ["&bSea Pickle&r, the reef's little lanterns. Smelt the &bSea Pickle Froglight&r and light up the shallows."]
	quest.7D0000000000000E.quest_subtitle: "Glowing and green."
	quest.7D0000000000000E.title: "Sea Pickle"
	quest.7D00000000000011.quest_desc: ["The last of the tide: &bNautilus Shell&r, the shell that aims a Conduit. Smelt the &bNautilus Shell Froglight&r and the aquatic roster is yours, top to bottom."]
	quest.7D00000000000011.quest_subtitle: "The Tide's treasure."
	quest.7D00000000000011.title: "Nautilus Shell"
	quest.7D00000000000020.quest_desc: [
		"No cold biome ever forms out here - &bice&r exists because a frog makes it. Nine ice pack to packed ice, nine packed to &bblue ice&r: the whole frozen family unlocks from this one variant."
		""
		"Turn in the &bIce Froglight&r. (Placement note: Froglights glow, and ice melts under bright light - do not light an ice farm with its own produce.)"
	]
	quest.7D00000000000020.quest_subtitle: "Winter, imported."
	quest.7D00000000000020.title: "Ice"
	quest.7D00000000000023.quest_desc: [
		"&fSnow&r never falls on the void either. Snow blocks from the frog mean snow layers, snowballs, and snow golems - build the blizzard yourself."
		""
		"Turn in the &bSnow Froglight&r."
	]
	quest.7D00000000000023.quest_subtitle: "Let it frog."
	quest.7D00000000000023.title: "Snow"
	quest.7F00000000000002.quest_desc: [
		"Your island has spread out under you, and walking it is getting old. Time to fly. &eIron Jetpacks&r runs on the metals your frogs already make and the &bRF&r your Geode machines already spin."
		""
		"No new resource to chase - just a new way to move."
	]
	quest.7F00000000000002.quest_subtitle: "Leave the ground behind."
	quest.7F00000000000002.title: "Take Flight"
	quest.7F00000000000005.quest_desc: ["Start with a &eLeather Strap&r - &fleather&r from your Bog frog, &firon nuggets&r from your Cave one. It's the harness everything else bolts onto."]
	quest.7F00000000000005.quest_subtitle: "The jetpack's harness."
	quest.7F00000000000005.title: "Leather Strap"
	quest.7F00000000000008.quest_desc: ["A &eBasic Coil&r - &firon&r, &fredstone&r, and a couple sticks - is the heart of the cheapest jetpack. Cave resources, all of it."]
	quest.7F00000000000008.quest_subtitle: "The first engine."
	quest.7F00000000000008.title: "Basic Coil"
	quest.7F0000000000000B.quest_desc: ["Build an &bIron Jetpack&r: the coil plus an iron &ecell&r, &ethruster&r, and &ecapacitor&r on the strap. Wear it in a &eCurios&r back slot (or over your chestplate) - you're a pilot now."]
	quest.7F0000000000000B.quest_subtitle: "Your first jetpack."
	quest.7F0000000000000B.title: "Off the Ground"
	quest.7F0000000000000E.quest_desc: [
		"A jetpack is dead weight without power. Charge it from any &bForge Energy&r source - a &eMekanism&r energy cube or cable off your Geode setup - then hold jump and lift off. Tap hover to hang in place."
		""
		"&aClaim this once you've flown.&r"
	]
	quest.7F0000000000000E.quest_subtitle: "Charge it, then soar."
	quest.7F0000000000000E.title: "Fuel and Fly"
	quest.7F00000000000011.quest_desc: ["An &eAdvanced Coil&r swaps the iron for &fgold&r - a faster, higher jetpack. Your Cave gold frog has you covered."]
	quest.7F00000000000011.quest_subtitle: "Higher, faster."
	quest.7F00000000000011.title: "Advanced Coil"
	quest.7F00000000000014.quest_desc: ["The &eElite Coil&r runs on &fdiamond&r. Geode gem-tier mobility: climb higher, burn fuel slower."]
	quest.7F00000000000014.quest_subtitle: "Most of the sky."
	quest.7F00000000000014.title: "Elite Coil"
	quest.7F00000000000017.quest_desc: ["The &eUltimate Coil&r tops it out with &femerald&r, the Geode capstone gem - the fastest jetpack in the pack. The void is yours to cross."]
	quest.7F00000000000017.quest_subtitle: "The whole sky."
	quest.7F00000000000017.title: "Ultimate Coil"
	quest.7F0000000000001A.quest_desc: [
		"No trial chambers generate over the void, so the vaults' prize comes from the press instead: the &eDissolution Chamber&r squeezes a &bHeavy Core&r out of &f4 iron blocks&r and &f4 prismarine&r under latex. Dense Cave ore, Tide stone - the chamber does the compacting so no ominous vault has to."
	]
	quest.7F0000000000001A.quest_subtitle: "Vault treasure, frog-pressed."
	quest.7F0000000000001A.title: "The Heavy Core"
	quest.7F0000000000001D.quest_desc: [
		"A &bBreeze Rod&r on the core and the &bMace&r is yours. Its smash scales with how far you FALL - and you just built a jetpack. Climb, cut thrust, land the hit; one &bbreeze rod&r also crafts &f4 wind charges&r to bounce yourself skyward mid-fight. Gravity is a weapon now."
	]
	quest.7F0000000000001D.quest_subtitle: "What goes up..."
	quest.7F0000000000001D.title: "Drop the Hammer"
	task.2A5700000A570003.title: "Got it"
	task.2A5700000A570023.title: "Breed two frogs with Sweetslime"
	task.570A6E0000000015.title: "Storage, sorted"
	task.65F6A1B2C3D40002.title: "Got it"
	task.6C1F0A2B3D4E5F62.title: "Build an enclosed habitat"
	task.7CA7E000C0DE0003.title: "Got it"
	chapter_group.0C4F0E0000000005.title: "Tier 5: Infernal"
	chapter.5140000000000001.title: "Road to Infernal"
	chapter.51F0000000000001.title: "Infernal Frogs"
	quest.3E17000000000002.quest_desc: [
		"Remember the &eOak Crucible&r wringing water out of leaves? Meet its big sibling: a &fbrick-and-iron basin&r that melts &bFroglights&r into &9fluids&r - water, lava, molten metal - no GUI, no power, just heat rising from whatever block sits underneath."
		""
		"The build is &firon&r and &cbricks&r: hammer cobblestone all the way down to &7dust&r, mix the dust into a &9water barrel&r for clay, smelt the clay into bricks, and frame them in iron."
		""
		"Craft the &eCrucible&r and park it over a &etorch&r to start."
	]
	quest.3E17000000000002.quest_subtitle: "Soup's on."
	quest.3E17000000000002.title: "The Froglight Crucible"
	quest.3E17000000000005.quest_desc: [
		"The ladder climbs from &etorch&r to &6campfire&r to &cfire&r to &6lava&r - and Froglights burn too: a placed &6Lava Froglight&r heats like lava, a &cBlaze Froglight&r burns hotter than fire, and Powah's &cBlazing Crystal Froglight&r is the hottest plate in the mod. Your farmed decor doubles as the smelter's fire. JEI's heat-ladder category lists every source."
		""
		"Craft a &6campfire&r - the first real step up from the torch."
	]
	quest.3E17000000000005.quest_subtitle: "Hotter is faster."
	quest.3E17000000000005.title: "Feed the Fire"
	quest.3E17000000000008.quest_desc: [
		"A &9Water Froglight&r melts into a full &9bucket of water&r - farmable water, from your &aCave frog&r of all things. The way in is the same craft as every Cave slime, keyed on the fluid itself: a &9water bucket&r, four stone, three sweetslime, and a Cave frogspawn bottle. (The bucket comes back empty.)"
		""
		"Turn in the &bWater Froglight&r."
	]
	quest.3E17000000000008.quest_subtitle: "The ocean, bottled."
	quest.3E17000000000008.title: "Water"
	quest.3E1700000000000B.quest_desc: [
		"A &6Lava Froglight&r melts into a full &6bucket of lava&r - renewable, no more cobble-crucible babysitting, which is poetic: a &6lava bucket&r from that very crucible, four stone, three sweetslime, and a Cave frogspawn bottle craft the &6Lava Slime&r that retires it. The whole loop runs at Tier 1."
		""
		"Turn in the &bLava Froglight&r."
	]
	quest.3E1700000000000B.quest_subtitle: "The floor is renewable."
	quest.3E1700000000000B.title: "Lava"
	quest.3E1700000000000E.quest_desc: [
		"The &eCasting Mold&r turns molten metal back into &fingots&r - pour with a bucket, pipe it, or skip the plumbing entirely: stack &cheat&r, &eCrucible&r, &eMold&r into a three-block tower and the Mold drinks straight from the basin."
		""
		"{image:kubejs:textures/quests/casting_tower.png width:220 height:181 align:center}"
		""
		"Craft a &eCasting Mold&r."
	]
	quest.3E1700000000000E.quest_subtitle: "Pour one out."
	quest.3E1700000000000E.title: "The Casting Mold"
	quest.3E17000000000011.quest_desc: [
		"Now the payoff: a metal &bFroglight&r melts into &etwo ingots&r worth of molten metal - the Crucible is this pack's ore doubling. Tower it up, hopper Froglights in, and let the Mold spit ingots while you do anything else."
		""
		"Tick when your tower casts its first doubled ingot."
	]
	quest.3E17000000000011.quest_subtitle: "Two for one."
	quest.3E17000000000011.title: "The Tower"
	quest.51F0000000000002.quest_desc: [
		"Netherrack was just the floor. Now the &cInfernal&r frog gives you everything the Nether was hiding:"
		""
		"obsidian, quartz, glowstone, blaze, and the metal at the bottom of it all."
	]
	quest.51F0000000000002.quest_subtitle: "The Nether chain opens."
	quest.51F0000000000002.title: "Beyond Netherrack"
	quest.51F0000000000005.quest_desc: [
		"&eNether quartz&r at last - comparators, observers, and the &bQuartz Enriched Iron&r that &eRefined Storage&r runs on. Turn in the &bQuartz Froglight&r."
	]
	quest.51F0000000000005.quest_subtitle: "The gate so many recipes wanted."
	quest.51F0000000000005.title: "Quartz"
	quest.51F0000000000008.quest_desc: [
		"&eGlowstone&r - for lamps, redstone toys, and beacons to come. Turn in the &bGlowstone Froglight&r."
	]
	quest.51F0000000000008.quest_subtitle: "Light that isn't a torch."
	quest.51F0000000000008.title: "Glowstone"
	quest.51F000000000000B.quest_desc: [
		"&eSoul Sand&r - bubble columns, wither fuel, and soul-speed paths. Turn in the &bSoul Sand Froglight&r."
	]
	quest.51F000000000000B.quest_subtitle: "It drags you down."
	quest.51F000000000000B.title: "Soul Sand"
	quest.51F000000000000E.quest_desc: [
		"&eSoul Soil&r - soul campfires and lanterns burn blue. Turn in the &bSoul Soil Froglight&r."
	]
	quest.51F000000000000E.quest_subtitle: "Blue fire country."
	quest.51F000000000000E.title: "Soul Soil"
	quest.51F0000000000011.quest_desc: [
		"&cBlaze rods&r - brewing stands, magic fuel, and the road to the End. No blaze hunt required, and each rod crafts into two powder."
		""
		"Turn in the &bBlaze Froglight&r."
	]
	quest.51F0000000000011.quest_subtitle: "Rods without the blaze."
	quest.51F0000000000011.title: "Blaze"
	quest.51F0000000000014.quest_desc: [
		"&8Netherite scrap&r - smelted from ancient debris no skyblock should reach. Four scrap plus gold makes a &8Netherite Ingot&r and the best gear in the game. The Infernal crown. Turn in the &bNetherite Scrap Froglight&r."
	]
	quest.51F0000000000014.quest_subtitle: "The metal at the bottom."
	quest.51F0000000000014.title: "Netherite Scrap"
	quest.51F0000000000017.quest_desc: [
		"&cNetherrack milk&r presses into an &8Obsidian Slime&r - the other portal stone, no bucket-and-lava dance required."
		""
		"Run it through the &eDissolution Chamber&r (Tier 5 slimes are chamber-only), turn in the &8Obsidian Froglight&r, and smelt it for &8obsidian&r whenever you need it."
	]
	quest.51F0000000000017.quest_subtitle: "The portal stone, on tap."
	quest.51F0000000000017.title: "Obsidian"
	chapter.52E0000000000001.title: "The Network"
	quest.52E0000000000002.quest_desc: [
		"Every &eRefined Storage&r part starts here: &biron&r forged with &enether quartz&r. Until the Infernal frog gave you quartz, none of this was buildable. Now it all is."
	]
	quest.52E0000000000002.quest_subtitle: "The key the whole network turns on."
	quest.52E0000000000002.title: "Quartz Enriched Iron"
	quest.52E0000000000005.quest_desc: [
		"The &eController&r is the network. Feed it &bForge Energy&r from your Geode-era Mekanism setup and everything downstream wakes up."
	]
	quest.52E0000000000005.quest_subtitle: "The heart that powers it."
	quest.52E0000000000005.title: "The Controller"
	quest.52E0000000000008.quest_desc: [
		"The &eGrid&r is the terminal - search, sort, and pull any item in the network from one screen."
	]
	quest.52E0000000000008.quest_subtitle: "Your window into everything."
	quest.52E0000000000008.title: "The Grid"
	quest.52E000000000000B.quest_desc: [
		"A &eDisk Drive&r full of &bStorage Disks&r is the network's memory. Start with a 1k disk; scale to 64k and beyond later."
	]
	quest.52E000000000000B.quest_subtitle: "Where it all lives."
	quest.52E000000000000B.title: "Disk Drive"
	quest.52E000000000000F.quest_desc: [
		"&eCable&r carries the network signal. Run it between the Controller, Grid, Disk Drive, and everything else."
	]
	quest.52E000000000000F.quest_subtitle: "Cables tie the network together."
	quest.52E000000000000F.title: "Wire It Up"
	quest.52E0000000000012.quest_desc: [
		"&eExternal Storage&r exposes a drawer, barrel, or chest to the network - your old Functional Storage wall becomes searchable."
	]
	quest.52E0000000000012.quest_subtitle: "Plug in the drawer wall."
	quest.52E0000000000012.title: "External Storage"
	quest.52E0000000000015.quest_desc: [
		"An &eImporter&r pulls items into the network; an &eExporter&r pushes them out. Wire a frog loop straight into storage."
	]
	quest.52E0000000000015.quest_subtitle: "Let it stock itself."
	quest.52E0000000000015.title: "Import and Export"
	quest.52E0000000000019.quest_desc: [
		"The &eCrafting Grid&r is a crafting table wired to the network - no hauling materials, it pulls them for you."
	]
	quest.52E0000000000019.quest_subtitle: "Craft straight from storage."
	quest.52E0000000000019.title: "Crafting Grid"
	quest.52E000000000001C.quest_desc: [
		"A &ePattern Grid&r records a recipe; an &eAutocrafter&r runs it on demand. Request an item and the network crafts the whole tree itself. The Infernal verb, complete - the network now runs the base for you."
	]
	quest.52E000000000001C.quest_subtitle: "Ask, and it builds."
	quest.52E000000000001C.title: "Autocrafting"
	quest.53A0000000000002.quest_desc: [
		"You have farmed every Infernal resource by hand - priming slimes, pouring milk, catching frogs, picking up Froglights. The &eTerrarium&r ends the hand-holding: a sealed box of frog farming that runs itself. Milk goes in one wall, Froglights come out another, and you never open the lid."
		""
		"Everything it needs is on your Infernal shopping list already - quartz, glowstone, blaze rods, magma cream, nether brick."
	]
	quest.53A0000000000002.quest_subtitle: "Frog farming, sealed and self-running."
	quest.53A0000000000002.title: "The Terrarium"
	quest.53A0000000000005.quest_desc: [
		"The &eTerrarium Controller&r is the brain: it takes &bSlime Milk&r piped or clicked into its outward face and rations it out to the &eSprinklers&r in the ceiling. It does &cnot accept boss Slime Milk&r, though - the wither and dragon trophies stay on their catalyst altars. Build it first - the whole structure forms around it."
		""
		"It takes the place of one wall block - on a flat face, not a corner or edge - facing OUT of the box. The walls themselves can be &aany solid block&r, so build the shell from whatever you like. Recipe: glowstone, a quartz block, blaze rods, magma cream, nether bricks."
	]
	quest.53A0000000000005.quest_subtitle: "The brain of the box."
	quest.53A0000000000005.title: "Terrarium Controller"
	quest.53A0000000000008.quest_desc: [
		"&eSprinklers&r make up the ceiling of the box and rain slimes down into it, spawning on the exact same rules a placed Slime Milk source uses - cadence, per-bucket budget, and &dcatalysts&r (Speed, Quantity, Count, Endless) all carry through from the milk. You need &eat least one&r; up to 25 fit a ceiling, so make as many as you want for faster rain."
		""
		"Drop a catalyst on a Sprinkler from above to upgrade it in place. Need to change the variant or reclaim the milk? Right-click a Sprinkler with an &eempty bucket&r to pull its Slime Milk back out."
	]
	quest.53A0000000000008.quest_subtitle: "Indoor weather, made of slime."
	quest.53A0000000000008.title: "Sprinklers"
	quest.53A000000000000B.quest_desc: [
		"&eIncubators&r raise frogspawn and tadpoles into frogs &ainside the box&r, stats intact over the whole lifecycle. Frogs bred in the cavity lay back into an Incubator (not water), so the line keeps itself stocked. A Sweetslime right-clicked in speeds incubation."
		""
		"One Incubator raises &eone frog at a time&r and stops releasing at the frog cap (8 by default) - so run &eseveral&r for throughput and feed them Sweetslimes. That cap is just the Incubators' release ceiling, not a wall on the cavity: you can always lead, net, or carry extra frogs in by hand."
		""
		"Incubators are &eoptional&r - the box forms with none. Add them only if you want frogs raised and bred in place; otherwise stock the Terrarium yourself. Each one goes on a wall, face pointing IN."
	]
	quest.53A000000000000B.quest_subtitle: "A nursery with the lights on."
	quest.53A000000000000B.title: "Incubators"
	quest.53A000000000000E.quest_desc: [
		"The &eHatch&r is the output: Froglights drop &bstraight into it&r - no item entity bouncing around the cavity - and it vacuums up any loose slimeballs, magma cream, or raw frog legs (from a frog that died inside) too. It opens as a chest and pipes out its outward face. When it fills, the frogs stop eating until you clear it (nothing is ever voided)."
		""
		"Exactly one. On a wall, facing IN."
	]
	quest.53A000000000000E.quest_subtitle: "Where the light comes out."
	quest.53A000000000000E.title: "The Hatch"
	quest.53A0000000000011.quest_desc: [
		"Seal it into a box. The interior is &e5 wide, 5 deep, 4 tall&r; wrap it in a one-block shell of any solid block. The &eController&r and the &eHatch&r sit on the walls facing IN (any &eIncubators&r you add go on the walls facing IN too); the &eSprinklers&r line the ceiling. No machines on corners or edges."
		""
		"&7Right-click the Controller&r - it tells you the formed state and points at the first wrong block until it reads &aformed&r. That readout is your blueprint; build to whatever it asks for."
		""
		"Check this off once the Controller says the Terrarium is formed."
	]
	quest.53A0000000000011.quest_subtitle: "Five by five by four, shell it in."
	quest.53A0000000000011.title: "Seal the Box"
	quest.53A0000000000014.quest_desc: [
		"Pipe (or pour) a bucket of &bSlime Milk&r into the Controller's outward face. It buffers one variant at a time and feeds the Sprinklers, which start raining that variant's slimes. Wire it from your milk farm and the rain never stops."
		""
		"Check this off once slimes are falling from the Sprinklers."
	]
	quest.53A0000000000014.quest_subtitle: "Turn on the rain."
	quest.53A0000000000014.title: "Prime the Sprinklers"
	quest.53A0000000000017.quest_desc: [
		"Get a frog living inside. Load &efrogspawn or tadpoles&r into an Incubator to raise one in place - or, if you skipped Incubators, lead or &enet&r a frog in directly. It eats the slimes the Sprinklers drop, and the Froglights land in the Hatch. Any species works - whatever frog lives in there, that resource farms itself."
		""
		"Check this off once a frog is living in the Terrarium."
	]
	quest.53A0000000000017.quest_subtitle: "Move the frogs in."
	quest.53A0000000000017.title: "Stock the Incubators"
	quest.53A000000000001A.quest_desc: [
		"Milk in one wall, Froglights out another, frogs and slimes you never have to touch. The Terrarium runs the loop you spent six tiers learning by hand. Wire its Hatch into storage and walk away - the swamp tends itself now."
	]
	quest.53A000000000001A.quest_subtitle: "Hands off. It runs itself."
	quest.53A000000000001A.title: "Hands Off"
	chapter.53A0000000000001.title: "The Terrarium"
	quest.5140000000000002.quest_desc: [
		"There's no Nether to raid, they said. There is now - you just have to build the door. Make 10 &eobsidian&r for a portal frame (skip the corners), craft a &eflint and steel&r, and raise it. The void Nether waits beyond."
	]
	quest.5140000000000002.quest_subtitle: "Tide gave you wings. Now use them."
	quest.5140000000000002.title: "A Portal to the Nether"
	quest.5140000000000007.quest_desc: [
		"Light the portal and walk in. The Nether here is a &cvoid&r - no floor, no ceiling, just dark and your jetpack. Fly."
	]
	quest.5140000000000007.quest_subtitle: "Step through."
	quest.5140000000000007.title: "Into the Nether"
	quest.514000000000000A.quest_desc: [
		"Somewhere out in the dark a &cNether Fortress&r floats. Find it, fly to it, mine its &enether brick&r - the only thing the void Nether hands out, and the key to the Infernal frog."
	]
	quest.514000000000000A.quest_subtitle: "The one thing you can't make yet."
	quest.514000000000000A.title: "Raid a Fortress"
	quest.514000000000000D.quest_desc: [
		"Home again. Prime the &eSpawnery&r with a &eNether Brick&r and it draws an &cInfernal Frogspawn&r."
		""
		"The fortress trip was the toll; the frog automates the rest."
	]
	quest.514000000000000D.quest_subtitle: "Feed the brick to the Spawnery."
	quest.514000000000000D.title: "Infernal Frogspawn"
	quest.5140000000000010.quest_desc: [
		"Same &eDissolution Chamber&r from the Tide. Feed it a &bNautilus Shell&r and &eprismarine&r filler for a &cNetherrack Slime in a Bucket&r."
	]
	quest.5140000000000010.quest_subtitle: "The chamber's first hellish brew."
	quest.5140000000000010.title: "A Bucket of Netherrack Slime"
	quest.5140000000000013.quest_desc: [
		"Pour the slime into a &eSlime Milker&r. &cNetherrack Slime Milk&r spawns Netherrack Slimes for the frog."
	]
	quest.5140000000000013.quest_subtitle: "Netherrack Slime Milk."
	quest.5140000000000013.title: "Milk It"
	quest.5140000000000016.quest_desc: [
		"Your Infernal frog eats a Netherrack Slime and leaves a &bNetherrack Froglight&r. Smelt it for &cnetherrack&r. From here the frog gives you the whole Nether - no more portal trips."
	]
	quest.5140000000000016.quest_subtitle: "Tier 5 opens."
	quest.5140000000000016.title: "First Netherrack"
	chapter_group.0C4F0E0000000006.title: "Tier 6: Void"
	chapter.601D000000000001.title: "Road to the Void"
	chapter.60F0000000000001.title: "Void Frogs"
	chapter.6EC0000000000001.title: "The Ultimate Table"
	chapter.6A0D000000000001.title: "Master Pond"
	quest.601D000000000002.quest_desc: [
		"The End is out there, past the void. To reach it you need &eEnder Pearls&r - and out here, &dEndermen&r spawn in full darkness. Wall off a dark room (or hunt the Nether's warped forest) and gather &e12&r:"
		""
		"two become &aEyes of Ender&r, and the rest prime the &dVoid Spawnery&r once you're through."
	]
	quest.601D000000000002.quest_subtitle: "The void wants a key."
	quest.601D000000000002.title: "Pearls from the Dark"
	quest.601D000000000005.quest_desc: [
		"Pearls plus &cBlaze Powder&r - one rod from your Infernal frog crafts into two - become &aEyes of Ender&r."
		""
		"Craft &a2&r: the cake wants a pair."
	]
	quest.601D000000000005.quest_subtitle: "Pearl plus powder."
	quest.601D000000000005.title: "Eyes of Ender"
	quest.601D000000000008.quest_desc: [
		"No stronghold floats in the void, so there is no portal to find. You bake your way in instead."
		""
		"The &dEnd Cake&r follows the old family recipe: &e3 buckets of milk&r across the top - &aMilk Buckets or any Slime Milk your frogs produce&r - an &eegg&r between &a2 Eyes of Ender&r, and &e3 wheat&r below."
		""
		"Plain &eMilk Buckets&r hand their empty buckets back; &dSlime Milk&r bakes in, bucket and all. The cake does not come back either way."
	]
	quest.601D000000000008.quest_subtitle: "If the world won't give you a portal, bake one."
	quest.601D000000000008.title: "Bake the End Cake"
	quest.601D00000000000B.quest_desc: [
		"Set the &dEnd Cake&r down somewhere you trust and &etake a bite&r. Each slice teleports whoever eats it straight to the End - &e6 slices&r per cake, so one bake covers a few trips (or a team)."
		""
		"You'll land on an obsidian platform beside the central island. Mind the drop, and mind &dher&r."
	]
	quest.601D00000000000B.quest_subtitle: "Eat the portal the world won't give you."
	quest.601D00000000000B.title: "Into the End"
	quest.601D00000000000E.quest_desc: [
		"The &5Ender Dragon&r guards the central island. This is the fight the whole pack has been walking toward. Bring beds, bring jetpacks, bring patience - then put it down."
	]
	quest.601D00000000000E.quest_subtitle: "The fight the pack was walking toward."
	quest.601D00000000000E.title: "Slay the Dragon"
	quest.601D000000000011.quest_desc: [
		"&eEnder Pearl&r primes the Spawnery for &5Void&r slimes. Raise a Void frog and let it lay."
		""
		"Turn in a &bBottle of Void Frog Frogspawn&r."
	]
	quest.601D000000000011.quest_subtitle: "The last species."
	quest.601D000000000011.title: "Void Frogspawn"
	quest.601D000000000014.quest_desc: [
		"Catch an &5Ender Pearl Slime&r in a bucket - the seed of the Void milk chain."
		""
		"(The Dissolution Chamber makes these too, if you would rather automate it.)"
	]
	quest.601D000000000014.quest_subtitle: "Bottle the void."
	quest.601D000000000014.title: "A Bucket of Ender Pearl Slime"
	quest.601D000000000017.quest_desc: [
		"Run the slime through the Slime Milker for a &bBucket of Ender Pearl Slime Milk&r - the food that turns a frog's light into &eender pearls&r."
	]
	quest.601D000000000017.quest_subtitle: "One more bucket."
	quest.601D000000000017.title: "Milk It"
	quest.601D00000000001A.quest_desc: [
		"Feed the milk, take the &bEnder Pearl Froglight&r, and the &5Void&r frog is yours."
		""
		"Tier 6 opens - the last species, and the road to the endgame."
	]
	quest.601D00000000001A.quest_subtitle: "Tier 6 opens."
	quest.601D00000000001A.title: "First Ender Pearl"
	quest.60F0000000000002.quest_desc: [
		"Ender pearls were just the doorway. The &5Void&r frog hands you the whole End:"
		""
		"end stone, chorus, echo shards, sculk, and the shells the shulkers leave behind."
	]
	quest.60F0000000000002.quest_subtitle: "The End, on tap."
	quest.60F0000000000002.title: "Beyond the Pearl"
	quest.60F0000000000005.quest_desc: [
		"&eEnd Stone&r - the ground of the outer islands, now a frog's job. Turn in the &bEnd Stone Froglight&r."
	]
	quest.60F0000000000005.quest_subtitle: "Pale and endless."
	quest.60F0000000000005.title: "End Stone"
	quest.60F0000000000008.quest_desc: [
		"&dChorus Fruit&r - teleport snacks, and popped chorus for purpur. Turn in the &bChorus Froglight&r."
	]
	quest.60F0000000000008.quest_subtitle: "A fruit that moves you."
	quest.60F0000000000008.title: "Chorus Fruit"
	quest.60F000000000000B.quest_desc: [
		"&3Echo Shards&r - recovery compasses, straight from the frog instead of the deep dark."
		""
		"Turn in the &bEcho Shard Froglight&r."
	]
	quest.60F000000000000B.quest_subtitle: "The deep dark, skipped."
	quest.60F000000000000B.title: "Echo Shard"
	quest.60F000000000000E.quest_desc: [
		"&3Sculk&r - XP blocks and redstone-by-sound. Turn in the &bSculk Froglight&r."
	]
	quest.60F000000000000E.quest_subtitle: "It listens."
	quest.60F000000000000E.title: "Sculk"
	quest.60F0000000000011.quest_desc: [
		"&dShulker Shells&r - shulker boxes, the only portable storage that survives the void."
		""
		"No shulker hunt required. Turn in the &bShulker Shell Froglight&r."
	]
	quest.60F0000000000011.quest_subtitle: "Boxes that come with you."
	quest.60F0000000000011.title: "Shulker Shell"
	quest.6EC0000000000002.quest_desc: [
		"The endgame's crafting spine is &6Extended Crafting&r. It starts plain: iron plus black dye (your Tide frog's ink) makes &7Black Iron&r. Everything here builds from it."
	]
	quest.6EC0000000000002.quest_subtitle: "Iron, dyed for greater things."
	quest.6EC0000000000002.title: "Black Iron"
	quest.6EC0000000000005.quest_desc: [
		"&eGlowstone, redstone, and gunpowder&r fuse into &eLuminessence&r - the spark inside every Extended Crafting component. Make some; you will need a lot."
	]
	quest.6EC0000000000005.quest_subtitle: "The spark in the machine."
	quest.6EC0000000000005.title: "Luminessence"
	quest.6EC0000000000008.quest_desc: [
		"A &63x3&r table that eats the Luminessence components. The first rung of the ladder."
		""
		"Craft the &6Basic Table&r."
	]
	quest.6EC0000000000008.quest_subtitle: "Bigger than a workbench, barely."
	quest.6EC0000000000008.title: "The Basic Table"
	quest.6EC000000000000B.quest_desc: [
		"&65x5&r now. Feed it a gold block and the basic table. Craft the &6Advanced Table&r."
	]
	quest.6EC000000000000B.quest_subtitle: "Five by five."
	quest.6EC000000000000B.title: "The Advanced Table"
	quest.6EC000000000000E.quest_desc: [
		"&67x7&r, built on a diamond block. Craft the &6Elite Table&r."
	]
	quest.6EC000000000000E.quest_subtitle: "Seven by seven."
	quest.6EC000000000000E.title: "The Elite Table"
	quest.6EC0000000000011.quest_desc: [
		"&69x9&r, crowned with an emerald block. The biggest grid in the pack, and the only one that can craft a Master Frog. Build the &6Ultimate Table&r."
	]
	quest.6EC0000000000011.quest_subtitle: "Nine by nine. The big one."
	quest.6EC0000000000011.title: "The Ultimate Table"
	quest.6EC0000000000014.quest_desc: [
		"The &dUltimate Catalyst&r is what the Quantum Compressor burns to fold thousands of items into one. Craft one to feed the compressor."
	]
	quest.6EC0000000000014.quest_subtitle: "Fuel for the fold."
	quest.6EC0000000000014.title: "The Ultimate Catalyst"
	quest.6EC0000000000017.quest_desc: [
		"The &dQuantum Compressor&r presses a thousand of a frog's resource into a single &bSingularity&r - one for every resource the frogs make. It runs on power - wire it to your Mekanism grid. Build it; the endgame starts here."
	]
	quest.6EC0000000000017.quest_subtitle: "A thousand of a haul, one cube."
	quest.6EC0000000000017.title: "The Quantum Compressor"
	quest.6A0D000000000002.quest_desc: [
		"You have cleared the dragon and built the compressor. One task remains: prove the frogs run without you. Each &bSingularity&r swallows a thousand of a frog's resource - you cannot hand-make that many. Only a running farm can. There is one singularity for every resource your frogs make - except water and lava, which pour rather than press:"
		""
		"The Ultimate Singularity wants every one - check its recipe for the full roster (it grows as the frogs learn new resources)."
	]
	quest.6A0D000000000002.quest_subtitle: "Prove the frogs run without you."
	quest.6A0D000000000002.title: "The Long Compression"
	quest.6A0D000000000005.quest_desc: [
		"Point your iron-frog farm at the Quantum Compressor and wait. A thousand iron folds into a single &bIron Singularity&r - the first of many, one for every resource the frogs make, from iron to shulker shells. Start here; you will want them all."
	]
	quest.6A0D000000000005.quest_subtitle: "A thousand iron, one cube."
	quest.6A0D000000000005.title: "Your First Singularity"
	quest.6A0D000000000008.quest_desc: [
		"Gather one Singularity for every resource the frogs make - every last one - and crystallize them together in the Ultimate Table into the &dUltimate Singularity&r: the densest form of everything your frogs ever made. This is the proof you automated every last farm."
	]
	quest.6A0D000000000008.quest_subtitle: "The densest frog there is."
	quest.6A0D000000000008.title: "The Ultimate Singularity"
	quest.6A0D00000000000B.quest_desc: [
		"Set the Ultimate Singularity in a crafting table, ring it with Froglights, and craft the &aSky Frogs Master Frog&r. It does nothing. It is everything."
	]
	quest.6A0D00000000000B.quest_subtitle: "The trophy at the end of the pond."
	quest.6A0D00000000000B.title: "The Sky Frogs Master Frog"
	quest.6A0D00000000000E.quest_desc: [
		"Set it on a shelf. You started on a speck of dirt with a bottle of frogspawn, and you turned frogs into the entire world - ore, gem, bog, ocean, nether, and void."
		""
		"There is nothing left to mine. Thanks for playing Sky Frogs."
	]
	quest.6A0D00000000000E.quest_subtitle: "Thanks for playing."
	quest.6A0D00000000000E.title: "You Out-Frogged the Game"
	quest.54E5F6A1B2C30041.quest_desc: [
		"A reusable net that scoops a frog into the item with a right-click and sets it back down where you right-click a block. The frog rides along &awhole&r - species, bred Appetite/Bounty/Reach, name, all of it - so you can move a prize frog without leashing it across the water (or killing it)."
		""
		"Six string and a stick - cheap enough to keep on your hotbar from day one. Relocate your starter frog, rearrange a pond, or restock a Terrarium later, no leash required."
	]
	quest.54E5F6A1B2C30041.quest_subtitle: "Catch and carry, stats intact."
	quest.54E5F6A1B2C30041.title: "The Frog Net"
	quest.601D00000000001D.quest_desc: [
		"Slaying the Ender Dragon - the princess - leaves behind a &dPrincess's Kiss&r. Right-click any frog with it and, in a shower of particles, the frog becomes a &evillager&r: a plain, unemployed one, free to take any job."
		""
		"One Kiss bootstraps an entire trading economy off your pond - which is exactly why it waits behind the dragon. Net the frog you want to transform first if it is a prize one; the Kiss does not care which frog, only that it is a frog."
	]
	quest.601D00000000001D.quest_subtitle: "The dragon was the princess all along."
	quest.601D00000000001D.title: "Princess's Kiss"
}
