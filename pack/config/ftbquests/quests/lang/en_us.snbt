	quest.7F0C831A136C804F.quest_desc: [
		"Every vanilla resource the frogs make, accounted for. The pond is whole - and so, apparently, are you."
	]
	quest.7F0C831A136C804F.quest_subtitle: "Sit. You've earned the lily pad."
	quest.7F0C831A136C804F.title: "The Whole Pond"
