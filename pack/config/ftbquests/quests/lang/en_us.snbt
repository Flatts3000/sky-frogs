	quest.70DD24314911C52A.title: "Improved Processor (Refined Storage)"
	quest.70DD11972EEAF468.title: "Advanced Processor (Refined Storage)"
	quest.70DD8BDEB27E47C3.title: "Steel (Mekanism)"
	quest.70DDCD212AE52B37.title: "Fluorite (Mekanism)"
	quest.70DDC61CE7A31EAF.title: "Refined Glowstone (Mekanism)"
	quest.70DD872930906038.title: "Refined Obsidian (Mekanism)"
