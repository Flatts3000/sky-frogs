	quest.7F0C6CC451D05B68.title: "Wither Skeleton Skull"
	quest.7F0CA0BDBEA09C67.title: "Chorus Fruit"
	quest.7F0C219B0FA62997.title: "Dragon Breath"
	quest.7F0C5DF32BECE5EE.title: "Dragon Egg"
	quest.7F0C86B4736048BE.title: "Echo Shard"
	quest.7F0C4637FB6F2985.title: "End Stone"
	quest.7F0CD0A688774E3F.title: "Ender Pearl"
	quest.7F0CEFBC82A9F1DB.title: "Phantom Membrane"
	quest.7F0C0597B23C28B8.title: "Sculk"
	quest.7F0C4A07248764ED.title: "Shulker Shell"
	quest.7F0C831A136C804F.quest_desc: [
		"Every vanilla resource the frogs make, accounted for. The pond is whole - and so, apparently, are you."
	]
	quest.7F0C831A136C804F.quest_subtitle: "Sit. You've earned the lily pad."
	quest.7F0C831A136C804F.title: "The Whole Pond"
	chapter.7F0C000000000001.title: "The Whole Pond"
	quest.70DD9CE8D28270C3.title: "Osmium (All the Ores)"
	quest.70DDE8959C46DE77.title: "Aluminum (All the Ores)"
