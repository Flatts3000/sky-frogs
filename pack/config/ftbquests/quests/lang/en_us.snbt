{
	chapter.1F00000000000001.title: "Tools and Things"
	chapter.2A5700000A570001.title: "Scaling the Colony"
	chapter.570A6E0000000001.title: "Storage and Crafting"
	chapter.60ADE60000000001.title: "Road to Geode"
	chapter.6C1F0A2B3D4E5F60.title: "Your First Iron Ingot"
	chapter.6E0DE00000000001.title: "Geode Frogs"
	chapter.6ECA150000000001.title: "Power and Machines"
	chapter.70B0000000000001.title: "Road to Bog"
	chapter.71DE000000000001.title: "Road to Tide"
	chapter.784143B9C5D63814.title: "Welcome"
	chapter.7B06000000000001.title: "Bog Frogs"
	chapter.7CA7E000C0DE0001.title: "Cave Frogs"
	chapter.3E17000000000001.title: "Melting Point"
	chapter.70E0000000000001.title: "Powered Up"
	chapter.7D00000000000001.title: "Drowned Riches"
	chapter.7F00000000000001.title: "Take Flight"
	chapter_group.0C4F0E0000000001.title: "Tier 1: Cave"
	chapter_group.0C4F0E0000000002.title: "Tier 2: Geode"
	chapter_group.0C4F0E0000000003.title: "Tier 3: Bog"
	chapter_group.0C4F0E0000000004.title: "Tier 4: Tide"
	chapter_group.0C4F0E0000000007.title: "Completionist"
	quest.111D15C0DE000001.quest_desc: [
		"Sky Frogs is built from player feedback - half of every update starts as somebody's message on the community Discord. Bugs, suggestions, screenshots of your pond: it all shapes the pack."
		""
		"Click the &9Discord badge&r floating above this quest to open an invite, or type &bdiscord.gg/r6MhZ73nsM&r into your browser."
	]
	quest.111D15C0DE000001.quest_subtitle: "The other frogs are waiting."
	quest.111D15C0DE000001.title: "Join the Pond"
	quest.01A8E068925B319F.quest_desc: [
		"An island of grass, floating in the void. That's the whole world - no ore under it, nowhere to dig."
		""
		"Instead, you hatch your own &afrogs&r. Feed one the right slime and it gives back the resource you'd normally mine for."
		""
		"Follow the quest book. Work from Cave tier up to Void tier, hatch frogs that can eat the Wither and the Ender Dragon."
	]
	quest.01A8E068925B319F.quest_subtitle: "Start here."
	quest.01A8E068925B319F.title: "Welcome to Sky Frogs"
	quest.05BFA1537298A589.quest_desc: [
		"Instead of mining, you get your materials from &afrogs&r. Feed a &aFrog&r its matching &bResource Slime&r and it makes a &6Froglight&r. Smelt the Froglight to get the resource."
	]
	quest.05BFA1537298A589.quest_subtitle: "The whole pitch, in three words."
	quest.05BFA1537298A589.title: "Frogs, Not Pickaxes"
	quest.1F00000000000002.quest_desc: [
		"Just Dire Things runs on &eGoo&r. Craft &fclay balls&r, &fmycelium&r, &frotten flesh&r, and &fsugar&r into a block of &ePrimogel Goo&r - your way into Direwolf20's machines. The mycelium comes off your &aBog frog&r."
		""
		"Place the goo, then set a &firon block&r or &fcoal block&r right next to it. The goo slowly creeps into that block and turns it into a raw ore. Mine the ore and you're off."
	]
	quest.1F00000000000002.quest_subtitle: "Just Dire Things begins."
	quest.1F00000000000002.title: "First Goo"
	quest.1F00000000000020.quest_desc: [
		"The &eSlime Churn&r runs the milk loop without the chase. Load it with a bucket of any variant's &eSlime Milk&r and a stack of empty buckets, and it fills each one with that variant's &bBucket of Slime&r. It matches a hand-placed milk pool exactly (same rate, same budget, same catalysts), except nothing hops away to catch."
		""
		"Craft a &eSlime Churn&r."
	]
	quest.1F00000000000020.quest_subtitle: "The Milker, in reverse."
	quest.1F00000000000020.title: "The Slime Churn"
	quest.1F00000000000005.quest_desc: [
		"&fFerricore&r is JDT's iron - the metal every Simple machine downstream needs. Set &firon blocks&r against your &ePrimogel Goo&r and it creeps into each one over a couple of minutes, turning it into &fRaw Ferricore Ore&r. Mine the ore and smelt it to a &bFerricore Ingot&r."
		""
		"Stock up. Everything Direwolf20 makes from here takes ferricore."
	]
	quest.1F00000000000005.quest_subtitle: "JDT's base metal."
	quest.1F00000000000005.title: "Ferricore Ingot"
	quest.1F0000000000000E.quest_desc: [
		"Done chasing dropped &6Froglights&r across the platform? An &eItem Collector&r vacuums up everything in a radius - Froglights, slimeballs, anything that hits the floor."
		""
		"Sink one into your habitat floor and stop bending over. It takes a diamond, two &fender pearls&r, hoppers, and ferricore - so farm a few enderman in the dark room first."
		""
		"Claim your reward."
	]
	quest.1F0000000000000E.quest_subtitle: "An item magnet."
	quest.1F0000000000000E.title: "Vacuum the Floor"
	quest.1F00000000000011.quest_desc: [
		"Building Gadgets 2 gives you fast block-placement tools. The &eExchanging Gadget&r swaps one block for another in place - refurbish your habitat or re-skin a wall without tearing it down first."
		""
		"(Mekanism hands you the basic &bBuilding Gadget&r as the Enrichment Chamber reward if you took that path; this is the next step up.)"
	]
	quest.1F00000000000011.quest_subtitle: "Swap blocks in bulk."
	quest.1F00000000000011.title: "Exchanging Gadget"
	quest.1F00000000000014.quest_desc: [
		"The &eCopy/Paste Gadget&r captures a shape into a &bTemplate&r and stamps it anywhere - build one frog habitat, paste it ten times, turn one corner of the platform into a whole pond."
		""
		"Your reward, the &bTemplate Manager&r, lets you name and save those templates to reuse later."
	]
	quest.1F00000000000014.quest_subtitle: "Build it twice."
	quest.1F00000000000014.title: "Copy, Paste"
	quest.1F00000000000017.quest_desc: [
		"A &eFluid Collector&r reaches into the block in front of it and slurps the fluid source - water, lava, latex, anything bucketable - into its internal tank."
		""
		"Pipe it into your &bDissolution Chamber&r's latex intake, your cobblegen's water feed, anywhere a bucket would have done. Bucket by hand never again."
	]
	quest.1F00000000000017.quest_subtitle: "Scoop fluids, no bucket."
	quest.1F00000000000017.title: "Fluid Collector"
	quest.1F0000000000001A.quest_desc: [
		"The other half of the pair. A &eFluid Placer&r pours from its tank into the block in front of it - infinite water spreads, lava cobblegens, automated infrastructure that fills itself."
		""
		"Pair it with a Fluid Collector and you've got a closed-loop fluid circuit."
	]
	quest.1F0000000000001A.quest_subtitle: "Pour fluids, no bucket."
	quest.1F0000000000001A.title: "Fluid Placer"
	quest.21B2C3D4E5F60001.quest_desc: ["Craft an Oak Barrel. It catches rain for more water than the one bucket you start with."]
	quest.21B2C3D4E5F60001.quest_subtitle: "Water from the sky."
	quest.21B2C3D4E5F60001.title: "A Rain Barrel"
	quest.21B2C3D4E5F60011.quest_desc: ["Shear your oak leaves for whole leaf blocks. The Oak Crucible melts them into water."]
	quest.21B2C3D4E5F60011.quest_subtitle: "Leaves, whole."
	quest.21B2C3D4E5F60011.title: "Strip the Leaves"
	quest.21B2C3D4E5F60021.quest_desc: ["Build an Oak Crucible, then right-click leaf blocks into it. They melt into water on their own, no heat needed."]
	quest.21B2C3D4E5F60021.quest_subtitle: "Leaves into water."
	quest.21B2C3D4E5F60021.title: "The Crucible"
	quest.21B2C3D4E5F60031.quest_desc: ["Two water sources one block apart make an infinite source in the gap between them."]
	quest.21B2C3D4E5F60031.quest_subtitle: "An infinite source."
	quest.21B2C3D4E5F60031.title: "Running Water"
	quest.2A5700000A570002.quest_desc: [
		"You've been hand-feeding slimes to frogs and carrying Froglights to the furnace one at a time. It works - it just doesn't scale."
		""
		"This chapter makes the operation self-sustaining: first a renewable food-and-breeding supply, then the pipes and collectors to run the slime loop without you."
		""
		"It starts, oddly enough, by pulverizing cobblestone."
	]
	quest.2A5700000A570002.quest_subtitle: "Let the colony run itself."
	quest.2A5700000A570002.title: "Hands Off"
	quest.2A5700000A570005.quest_desc: [
		"Botany Pots are built from clay, and clay starts as &7cobblestone&r run through a Hammer."
		""
		"Pound cobblestone into gravel, gravel into sand, and sand into &eDust&r. You already have the Iron Hammer from the cobble quest - put it to work."
	]
	quest.2A5700000A570005.quest_subtitle: "Cobble into dust."
	quest.2A5700000A570005.title: "Grind It Down"
	quest.2A5700000A570008.quest_desc: [
		"Fill an Ex Deorum &bBarrel&r with water, drop the &eDust&r in, and it settles into a block of &fclay&r."
		""
		"Same barrel that catches your rainwater - it just does chemistry too."
	]
	quest.2A5700000A570008.quest_subtitle: "Dust into clay."
	quest.2A5700000A570008.title: "Just Add Water"
	quest.2A5700000A57000B.quest_desc: [
		"Now bake it. Smelt a clay block into &eTerracotta&r. Crumble clay into clay balls, smelt those into bricks, and three bricks make a &eFlower Pot&r."
		""
		"You'll want &bfive terracotta&r and one flower pot for what's next, so keep the barrel running."
	]
	quest.2A5700000A57000B.quest_subtitle: "Clay into terracotta."
	quest.2A5700000A57000B.title: "Fired Earth"
	quest.2A5700000A57000F.quest_desc: [
		"Five terracotta around a flower pot builds a &aBotany Pot&r - a self-tending planter. Drop in soil and a crop and it grows on its own, no farmland or sky needed. Trees too: give a pot a sapling and it runs the whole orchard."
		""
		"Here's your first crop: &asugar cane&r. Plant it and you've got a renewable source of sugar - which is about to matter a great deal."
	]
	quest.2A5700000A57000F.quest_subtitle: "A pot for plants."
	quest.2A5700000A57000F.title: "A Pot to Grow In"
	quest.2A5700000A570012.quest_desc: [
		"Sugar cane crafts into &fsugar&r. Sugar plus a &aslime ball&r makes &dSweetslime&r - the one treat a frog will breed for."
		""
		"Sweetslime is the key to everything ahead: breed your frogs into a real colony with it, and it's the binding agent for coaxing brand-new resource slimes out of the ones you've already got."
	]
	quest.2A5700000A570012.quest_subtitle: "Sugar, the frog way."
	quest.2A5700000A570012.title: "Sweet Tooth"
	quest.2A5700000A570015.quest_desc: [
		"Dirt is finite up here - until you start &amaking&r it."
		""
		"Fill an Ex Deorum &eBarrel&r with organic scraps - saplings, leaves, seeds, the overflow from your tree farm - and it rots down into a block of &6dirt&r. Free earth, forever."
	]
	quest.2A5700000A570015.quest_subtitle: "Compost into soil."
	quest.2A5700000A570015.title: "Dirt from Decay"
	quest.2A5700000A570018.quest_desc: [
		"Use a glass bottle of water on a block of dirt (right-click it) and the dirt turns to &6mud&r."
		""
		"Mud sits just shy of a full block, so dropped items fall straight through it into whatever's below - which is how you'll catch your Froglights. Here are eight more, for &bnine&r total: enough to floor a 3x3 pen."
	]
	quest.2A5700000A570018.quest_subtitle: "Wet dirt, on purpose."
	quest.2A5700000A570018.title: "Make Mud"
	quest.2A5700000A57001B.quest_desc: [
		"A &7hopper&r under each mud block swallows whatever falls through it."
		""
		"Craft one to prove the recipe - here are eight more, for &bnine&r total: one beneath every square of your 3x3 mud floor."
	]
	quest.2A5700000A57001B.quest_subtitle: "Catch what drops."
	quest.2A5700000A57001B.title: "A Floor of Hoppers"
	quest.2A5700000A57001E.quest_desc: [
		"The last piece. Craft an &eIron Furnace&r - unlike a vanilla one, it can push its finished output straight into an adjacent inventory. Open it and toggle &eAuto Output&r on."
		""
		"Stand your frog on the 3x3 mud floor. Funnel the nine hoppers beneath it into the Iron Furnace, and set a chest against its output side. Now Froglights drop through the mud, ride the hoppers into the furnace, get smelted into ingots, and stack up in the chest - all while you're off doing something else."
		""
		"A frog that mines iron in its sleep."
	]
	quest.2A5700000A57001E.quest_subtitle: "Smelt while you sleep."
	quest.2A5700000A57001E.title: "Hands-Free Froglights"
	quest.2A5700000A570022.quest_desc: [
		"You've got &dSweetslime&r now - which means you can &abreed your frogs&r."
		""
		"Feed it to two grown frogs and they'll pair off and breed, laying in the &bwater pool&r."
		""
		"After a pairing they need a cooldown before they will breed again (a few minutes), so don't expect babies back to back. If a pairing looks like it did nothing, give it time and check they have water, since they only lay in the pool, never on land."
		""
		"Pair off two frogs to begin. The next quest, &bRaising the Line&r, is where breeding gets interesting."
	]
	quest.2A5700000A570022.quest_subtitle: "Pair them off."
	quest.2A5700000A570022.title: "Breed Your Frogs"
	quest.2A5700000A570034.quest_desc: [
		"Breeding isn't just &omore&r frogs. Done right, it's &lbetter&r ones."
		""
		"Every Resource Frog carries three stats. Point &bJade&r at a frog, tadpole, or primed egg to read them:"
		""
		"&aAppetite&r: how fast it eats. Higher means a shorter cooldown between slimes, so more Froglights per minute."
		"&eBounty&r: how many Froglights it drops per slime fed. Higher means more output from the same slime."
		"&bReach&r: how far it senses slimes. Higher means less piling slimes against its nose."
		""
		"Stats run &b1 to 10&r. Egg-hatched frogs start low, around 1 to 3. A &l10/10/10&r frog is the long game, and breeding is the only road there."
		""
		"A baby's stats start at the &eaverage&r of its parents, and each stat then has a chance to &aclimb a point higher&r. Every breed lifts at least one, and a baby never drops below the parents' average, so you can't breed backward. The rule that follows: pair your &lbest with your best&r to hold a high average and climb toward &l10/10/10&r. A weak frog in the mix just drags the average down. (Averaging cuts the other way too. Breed a high-&aAppetite&r frog with a high-&eBounty&r one and the pair meets in the middle, balanced.)"
	]
	quest.2A5700000A570034.quest_subtitle: "Breed a better frog."
	quest.2A5700000A570034.title: "Raising the Line"
	quest.2A5700000A570031.quest_desc: [
		"Your frogs have earned names. &eName Tags&r craft from &fstring&r and &fpaper&r, and you have both by now: string off your silkworms, paper from your sugar cane."
		""
		"Rename a Name Tag on an &eanvil&r, then right-click a frog with it. Here are four more, enough to christen a starting colony."
	]
	quest.2A5700000A570031.quest_subtitle: "Give them names."
	quest.2A5700000A570031.title: "Name Your Frogs"
	quest.32C3D4E5F6A10001.quest_desc: ["Break oak leaves with a Crook for extra drops: saplings to replant, and the occasional &eSilkworm&r."]
	quest.32C3D4E5F6A10001.quest_subtitle: "For leaves, gently."
	quest.32C3D4E5F6A10001.title: "A Crook"
	quest.32C3D4E5F6A10011.quest_desc: ["Crook oak leaves until a Silkworm drops, then place it on a leaf block. It spreads outward, infesting the leaves around it. Those infested leaves are what give string."]
	quest.32C3D4E5F6A10011.quest_subtitle: "Shake the trees."
	quest.32C3D4E5F6A10011.title: "Silkworms"
	quest.32C3D4E5F6A10021.quest_desc: ["Once your leaves are &efully infested&r, crook them again and they drop &fstring&r instead of silkworms. Get four."]
	quest.32C3D4E5F6A10021.quest_subtitle: "No spiders required."
	quest.32C3D4E5F6A10021.title: "String from Silk"
	quest.32C3D4E5F6A10031.quest_desc: ["Craft a bed from your string. Sleep in it to skip the night and set your spawn point."]
	quest.32C3D4E5F6A10031.quest_subtitle: "Skip the night."
	quest.32C3D4E5F6A10031.title: "A Bed of Your Own"
	quest.378B93672C31CF5D.quest_desc: [
		"Your first frog is the &eCave Frog&r. It gets you ingots and other cave resources: iron, copper, gold, and the rest of the cave tier."
		""
		"First you need to get the basics done. You need glass for bottles, cobblestone, a mob farm for slime balls. Then you'll be able to hatch your first Cave Frog."
	]
	quest.378B93672C31CF5D.quest_subtitle: "Everything points at iron."
	quest.378B93672C31CF5D.title: "The Road to Iron"
	quest.43D4E5F6A1B20001.quest_desc: ["A wooden pickaxe will help you get the cobblestone you need."]
	quest.43D4E5F6A1B20001.quest_subtitle: "Stone beats fist."
	quest.43D4E5F6A1B20001.title: "Tools of the Trade"
	quest.43D4E5F6A1B20011.quest_desc: [
		"A cobblestone generator makes cobblestone wherever flowing lava runs into water. Mine it and it reforms, so you never run out."
		""
		"Let the lava flow into the water, not water onto the lava source: flowing lava makes cobblestone, but a lava source touched by water turns to obsidian."
	]
	quest.43D4E5F6A1B20011.quest_subtitle: "The first renewable rock."
	quest.43D4E5F6A1B20011.title: "Cobblestone"
	quest.43D4E5F6A1B20021.quest_desc: ["Use the &eIron Hammer&r to crush cobblestone into gravel, and the gravel into sand."]
	quest.43D4E5F6A1B20021.quest_subtitle: "Crushed from cobble."
	quest.43D4E5F6A1B20021.title: "Sand"
	quest.43D4E5F6A1B20031.quest_desc: ["Smelt that sand into glass."]
	quest.43D4E5F6A1B20031.quest_subtitle: "Sand, meet fire."
	quest.43D4E5F6A1B20031.title: "Glass"
	quest.43D4E5F6A1B20041.quest_desc: [
		"The &eStone Block Generator&r makes cobblestone on its own. Place water on one side, lava on the other, and storage on top."
	]
	quest.43D4E5F6A1B20041.quest_subtitle: "Rock, on tap."
	quest.43D4E5F6A1B20041.title: "Stone Block Generator"
	quest.54E5F6A1B2C30001.quest_desc: ["&aCave Slimes&r spawn in the dark. Build a sealed, unlit room &eat least 5x5 and 3 blocks tall&r. Nothing spawns within &b24 blocks&r of you, so step away and let it fill, then cut the slimes down for &eslime balls&r."]
	quest.54E5F6A1B2C30001.quest_subtitle: "Where slimes feel safe."
	quest.54E5F6A1B2C30001.title: "A Dark Room"
	quest.54E5F6A1B2C30011.quest_desc: ["A &acomposter&r turns spare saplings, leaves, and seeds into &ebone meal&r."]
	quest.54E5F6A1B2C30011.quest_subtitle: "Rot into green."
	quest.54E5F6A1B2C30011.title: "A Composter"
	quest.54E5F6A1B2C30021.quest_desc: ["&aThe Spawnery&r runs like a furnace: a &fglass bottle&r, a slime ball for fuel, and a resource that sets which frog you get. Out comes that frog's egg in the bottle."]
	quest.54E5F6A1B2C30021.quest_subtitle: "The frog factory."
	quest.54E5F6A1B2C30021.title: "The Spawnery"
	quest.54E5F6A1B2C30031.quest_desc: [
		"Insert &acobblestone&r (the Cave Frog's resource), a slime ball for fuel, and a glass bottle into the Spawnery. Out comes a &eBottle of Cave Frog Eggs&r."
		""
		"Make &btwo&r for a breeding pair, then right-click them onto a water source block to hatch."
	]
	quest.54E5F6A1B2C30031.quest_subtitle: "Your first frogs."
	quest.54E5F6A1B2C30031.title: "Synthesize Life"
	quest.570A6E0000000002.quest_desc: [
		"The metal's piling up faster than your chests can hold it. Time for storage that grows with you."
		""
		"A &eBarrel&r starts as a plain wooden box - but it takes &fupgrades&r that stack it deeper, pull items in on their own, and pack them down. Craft your first; everything here slots into it."
	]
	quest.570A6E0000000002.quest_subtitle: "Somewhere to dump it all."
	quest.570A6E0000000002.title: "A Barrel of Your Own"
	quest.570A6E0000000005.quest_desc: [
		"A barrel climbs through tiers, and the Cave frog hands you exactly what each one wants: &6copper&r, &eiron&r, then &egold&r. Every tier multiplies what it holds."
		""
		"Work one up to a &eGold Barrel&r."
	]
	quest.570A6E0000000005.quest_subtitle: "Upgrade the barrel."
	quest.570A6E0000000005.title: "Bigger on the Inside"
	quest.570A6E0000000008.quest_desc: [
		"Here's the real magic. A &eStack Upgrade&r dropped into a barrel doubles what every slot holds - and the higher tiers multiply it further still, so one barrel keeps up with a frog farm."
		""
		"Craft one and slot it in."
	]
	quest.570A6E0000000008.quest_subtitle: "More per slot."
	quest.570A6E0000000008.title: "Stack 'Em High"
	quest.570A6E000000000B.quest_desc: [
		"A &ePickup Upgrade&r tells a barrel to grab items off the ground around it - no more sweeping up after your frogs."
		""
		"The &asticky piston&r it needs is a slime ball away, and slime is the one thing you're never short of. Craft one."
	]
	quest.570A6E000000000B.quest_subtitle: "It picks up after you."
	quest.570A6E000000000B.title: "Hands-Free Intake"
	quest.570A6E000000000E.quest_desc: [
		"&bCompacting Drawers&r each hold one resource by the thousand and auto-pack its nuggets, ingots, and blocks together - one drawer per Cave metal makes a tidy wall."
		""
		"Tie that wall together: a &eStorage Controller&r linked to your drawers lets you pull from all of them in one spot. (It used to want nether quartz - not in this pack. Stone, redstone, and a repeater do it.)"
	]
	quest.570A6E000000000E.quest_subtitle: "One block, one item, lots."
	quest.570A6E000000000E.title: "A Wall of Drawers"
	quest.570A6E0000000011.quest_desc: [
		"The last piece for your barrels. A &eStorage Controller&r set against them opens every connected barrel through one searchable window, and a &eStorage Link&r + &eStorage Tool&r reach the ones too far to touch."
		""
		"No power, no nether quartz - just a repeater where the comparator used to go. (The links want &dender pearls&r; your dark room coughs those up.)"
		""
		"This is the storage you live on until the Infernal tier - that's where &eRefined Storage&r takes it digital."
	]
	quest.570A6E0000000011.quest_subtitle: "A storage network."
	quest.570A6E0000000011.title: "One Window on Everything"
	quest.570A6E0000000014.quest_desc: [
		"Barrels that swallow stacks, drawers that pack themselves, one window onto all of it - and the &eCrafting Station&r you've had since day one, pulling parts straight from the pile beside it. The island that began with a single chest now keeps its own house."
		""
		"This is the floor the rest of the pack gets built on. When the Infernal tier lands &eRefined Storage&r, the whole thing goes digital - but that's a long way down the line."
	]
	quest.570A6E0000000014.quest_subtitle: "The whole storage suite."
	quest.570A6E0000000014.title: "A Place for Everything"
	quest.570A6E0000000019.quest_desc: [
		"Your drawers handle solids - give liquids the same treatment. A &eFluid Drawer&r is the wet cousin of your drawer wall: planks and a bucket, and it holds a tide of one fluid - water, lava, milk, honey - with the amount right on the face."
		""
		"Best part: it links into the same &eStorage Controller&r as your item drawers, so it joins the network for free."
	]
	quest.570A6E0000000019.quest_subtitle: "Store the fluids too."
	quest.570A6E0000000019.title: "Liquid Assets"
	quest.570A6E000000001C.quest_desc: [
		"When a drawer won't cut it, a &eBasic Fluid Tank&r is bulk fluid in a box - just &firon&r and &credstone&r, no machines and no osmium in sight."
		""
		"Pick it up full and haul it wherever you need. It's the right home for the &6lava&r you'll be stockpiling to feed the machines a few tiers from now."
	]
	quest.570A6E000000001C.quest_subtitle: "A fluid tank."
	quest.570A6E000000001C.title: "Tanks a Lot"
	quest.570A6E000000001F.quest_desc: [
		"Not everything's worth a slot. An &eItem Trash Can&r quietly voids whatever you feed it - the cobble your generator won't stop making, junk mob drops, the fourth stack of rotten flesh."
		""
		"Set its filter so it only eats what you tell it to, drop a hopper on top, and forget it."
	]
	quest.570A6E000000001F.quest_subtitle: "Void the junk."
	quest.570A6E000000001F.title: "Take Out the Trash"
	quest.60ADE60000000002.quest_desc: [
		"You've wrung every metal the Cave frog knows out of bare stone. Time to look past it - the Geode frog deals in gems and crystals."
		""
		"Your Spawnery hatched your first Cave frogs from cobblestone; now feed it a slime ball and prime it with &credstone&r instead. Out comes a &dBottle of Geode Frog Eggs&r - tip it onto water for Geode frogs."
	]
	quest.60ADE60000000002.quest_subtitle: "Tier 2 begins."
	quest.60ADE60000000002.title: "The Road to Geode"
	quest.60ADE60000000005.quest_desc: [
		"Run your &bLapis Slime in a Bucket&r through the &eSlime Milker&r for a bucket of &9Lapis Slime Milk&r."
		""
		"Pour it out and Lapis Slimes spawn - the start of real lapis production."
	]
	quest.60ADE60000000005.quest_subtitle: "Milk the blue."
	quest.60ADE60000000005.title: "A Bucket of Lapis Slime Milk"
	quest.60ADE60000000008.quest_desc: [
		"Feed your Lapis Slimes to a Geode frog and turn in the &6Lapis Froglight&r it leaves. Smelt that Froglight for your first &9lapis lazuli&r."
		""
		"The gem chain runs on from here - amethyst, emerald, and diamond to cap it - but that's the next chapter."
		""
		"And a &bCompacting Drawer&r to bank the lapis you're about to mass-produce."
	]
	quest.60ADE60000000008.quest_subtitle: "The gems open up."
	quest.60ADE60000000008.title: "First Lapis"
	quest.60ADE6000000000B.quest_desc: [
		"Geode frogs eat Geode slimes, and the first one threads straight off the Cave's last resource."
		""
		"Craft a &bLapis Slime in a Bucket&r from a bucket of &credstone Slime Milk&r - plus four gravel, three sweetslime, and a bottle of Geode Frog Eggs."
	]
	quest.60ADE6000000000B.quest_subtitle: "Blue slime, bottled."
	quest.60ADE6000000000B.title: "A Lapis Slime in a Bucket"
	quest.65F6A1B2C3D40001.quest_desc: [
		"Two quality-of-life tricks worth knowing:"
		""
		"&aSquat Grow&r - repeatedly sneak next to a sapling or crop and it grows. Plant your oak, squat on it a few times, skip the wait."
		""
		"&bFTB Ultimine&r - break a whole tree or crop patch in one go. Bind the &eUltimine&r key under Options -> Controls, then hold it and break one block; every connected log or crop comes with it."
	]
	quest.65F6A1B2C3D40001.quest_subtitle: "Work less, frog more."
	quest.65F6A1B2C3D40001.title: "Two Shortcuts"
	quest.6C1F0A2B3D4E5F61.quest_desc: [
		"Before you hatch frogs, build a pen they can't jump out of. Frogs jump high, and one that clears the wall is gone into the void. Build tall walls, or cap it with a roof."
		""
		"Sink a &bwater&r pool into the floor, &b3x3 and two deep&r. Eggs hatch there, and a breeding pair lays there; a roomy pool is more reliable than a one-block puddle."
		""
		"Tadpoles are fragile: they must stay in the water the couple of minutes it takes them to grow, and one stranded on land dies."
	]
	quest.6C1F0A2B3D4E5F61.quest_subtitle: "Build them a home."
	quest.6C1F0A2B3D4E5F61.title: "A Place for Frogs"
	quest.6C1F0A2B3D4E5F64.quest_desc: ["A &eLead&r ties a frog to a fence so it can't hop off the island. Leash each frog once it grows up."]
	quest.6C1F0A2B3D4E5F64.quest_subtitle: "A leash for the ledge."
	quest.6C1F0A2B3D4E5F64.title: "Keep Them Close"
	quest.6C1F0A2B3D4E5F67.quest_desc: ["The &eSlime Milker&r takes a &bSlime in a Bucket&r and, a few seconds later, turns it into a bucket of that slime's milk."]
	quest.6C1F0A2B3D4E5F67.quest_subtitle: "Milk a slime, somehow."
	quest.6C1F0A2B3D4E5F67.title: "The Slime Milker"
	quest.6C1F0A2B3D4E5F6A.quest_desc: [
		"Your &aCave Frogs&r will need slimes to eat. First craft an &bIron Slime in a Bucket&r. This is the first of many resource slimes you'll create."
		""
		"Hold on to at least one bucket of slime, one bucket of slime milk, or a &6Froglight&r of each resource, or you may have to craft up the chain all over again."
	]
	quest.6C1F0A2B3D4E5F6A.quest_subtitle: "Iron you can pour."
	quest.6C1F0A2B3D4E5F6A.title: "Iron Slime in a Bucket"
	quest.6C1F0A2B3D4E5F6D.quest_desc: [
		"Run your &bIron Slime in a Bucket&r through the &eSlime Milker&r for a bucket of &bIron Slime Milk&r."
		""
		"Empty that bucket on the ground and it spawns &aIron Slimes&r. The pool runs dry after a batch, so catch and milk those slimes for more buckets to keep it going."
	]
	quest.6C1F0A2B3D4E5F6D.quest_subtitle: "Press out the milk."
	quest.6C1F0A2B3D4E5F6D.title: "Milk It"
	quest.6C1F0A2B3D4E5F70.quest_desc: ["A &aCave Frog&r eats an &aIron Slime&r and drops an &6Iron Froglight&r."]
	quest.6C1F0A2B3D4E5F70.quest_subtitle: "Slime in, Froglight out."
	quest.6C1F0A2B3D4E5F70.title: "Feed the Frog"
	quest.6C1F0A2B3D4E5F73.quest_desc: ["Smelt the &6Iron Froglight&r in a furnace for an iron ingot."]
	quest.6C1F0A2B3D4E5F73.quest_subtitle: "No ore was harmed."
	quest.6C1F0A2B3D4E5F73.title: "Your First Iron Ingot"
	quest.6E0DE00000000002.quest_desc: [
		"You've pulled lapis out of a Geode frog. The same frog has the rest of the gems in it: amethyst, emerald, and diamond - each a step further down the chain."
		""
		"Same loop you ran for the metals, new stones to feed it. Work it down to diamond."
	]
	quest.6E0DE00000000002.quest_subtitle: "The Geode chain opens."
	quest.6E0DE00000000002.title: "Beyond Lapis"
	quest.6E0DE00000000005.quest_desc: ["Craft an &bAmethyst Slime in a Bucket&r, feed your &aGeode Frog&r, and turn in the &6Amethyst Froglight&r."]
	quest.6E0DE00000000005.quest_subtitle: "Purple and pointy."
	quest.6E0DE00000000005.title: "Amethyst"
	quest.6E0DE00000000008.quest_desc: ["Craft an &bEmerald Slime in a Bucket&r, feed your &aGeode Frog&r, and turn in the &6Emerald Froglight&r."]
	quest.6E0DE00000000008.quest_subtitle: "Villager-grade, frog-made."
	quest.6E0DE00000000008.title: "Emerald"
	quest.6E0DE0000000000B.quest_desc: ["Craft a &bDiamond Slime in a Bucket&r, feed your &aGeode Frog&r, and turn in the &6Diamond Froglight&r."]
	quest.6E0DE0000000000B.quest_subtitle: "From a frog. Really."
	quest.6E0DE0000000000B.title: "Diamond"
	quest.6E0DE0000000000E.quest_desc: [
		"The geode's outer shell. Craft a &bTuff Slime in a Bucket&r from your &elapis milk&r (plus four gravel, three sweetslime, and a bottle of Geode Frog Eggs)."
		""
		"Milk it, feed the slimes to a Geode Frog, and turn in the &6Tuff Froglight&r - the first stone the Geode frog gives past lapis. Smelt it for tuff."
	]
	quest.6E0DE0000000000E.quest_subtitle: "Rough but useful."
	quest.6E0DE0000000000E.title: "Tuff"
	quest.6E0DE00000000011.quest_desc: ["Craft a &bCalcite Slime in a Bucket&r, feed your &aGeode Frog&r, and turn in the &6Calcite Froglight&r."]
	quest.6E0DE00000000011.quest_subtitle: "The geode's pale shell."
	quest.6E0DE00000000011.title: "Calcite"
	quest.6E0DE00000000014.quest_desc: [
		"Your Slime Milk sources don't have to run dry so fast. Craft a &bBountiful Catalyst&r (two &fsweetslime&r and a scoop of &fbone meal&r) and drop it straight into a placed &eSlime Milk&r pool."
		""
		"The buff saves to the source - it even rides along if you bucket the source back up. Stack as many as you like; this one has no cap."
	]
	quest.6E0DE00000000014.quest_subtitle: "More slime per source."
	quest.6E0DE00000000014.title: "Bountiful Catalyst"
	quest.6E0DE00000000017.quest_desc: [
		"A &bRapid Catalyst&r (two &fsweetslime&r and &fsugar&r) makes a source spit slimes out faster. Toss it in the pool like the last one."
		""
		"The boost climbs to a cap, so a few per source is plenty."
	]
	quest.6E0DE00000000017.quest_subtitle: "Faster slime."
	quest.6E0DE00000000017.title: "Rapid Catalyst"
	quest.6E0DE0000000001A.quest_desc: [
		"A &bTeeming Catalyst&r (two &fsweetslime&r and &fredstone&r) makes a source spawn more slimes at once - more bodies per batch for your frogs to eat."
		""
		"Like the Rapid Catalyst, it climbs to a cap."
	]
	quest.6E0DE0000000001A.quest_subtitle: "Bigger batches."
	quest.6E0DE0000000001A.title: "Teeming Catalyst"
	quest.6E0DE0000000001D.quest_desc: [
		"The big one. Ring eight &bBountiful Catalysts&r around a &fdiamond&r to forge an &bEndless Catalyst&r, then drop it in: that source &enever runs dry&r again."
		""
		"This is what the diamonds were for. One per source and you never re-prime it."
	]
	quest.6E0DE0000000001D.quest_subtitle: "An endless source."
	quest.6E0DE0000000001D.title: "Never Runs Dry"
	quest.6ECA150000000002.quest_desc: [
		"Mekanism runs on &fosmium&r - and the Cave frog has had it all along. Craft an &bOsmium Slime in a Bucket&r from your &eredstone milk&r (plus four stone, three sweetslime, and a bottle of Cave Frog Eggs)."
		""
		"Milk it, feed the slimes to a Cave Frog, and turn in the &6Osmium Froglight&r. Smelt it for osmium - no ore, no mining, the metal that opens Mekanism straight off a frog."
	]
	quest.6ECA150000000002.quest_subtitle: "Mekanism's starter metal."
	quest.6ECA150000000002.title: "Osmium"
	quest.6ECA150000000005.quest_desc: ["Machines need power. Build a &eHeat Generator&r - Mekanism's starter - and feed it &fcoal&r (your Cave frog makes it) or a bucket of lava. That trickle of Joules runs everything that follows."]
	quest.6ECA150000000005.quest_subtitle: "Electricity arrives."
	quest.6ECA150000000005.title: "First Power"
	quest.6ECA150000000008.quest_desc: [
		"The &eMetallurgic Infuser&r is the gateway machine - it presses one material into another, powered off your generator."
		""
		"It's how you turn iron into the enriched iron that becomes steel."
	]
	quest.6ECA150000000008.quest_subtitle: "Infuse and combine."
	quest.6ECA150000000008.title: "The Metallurgic Infuser"
	quest.6ECA15000000000B.quest_desc: [
		"In the &eMetallurgic Infuser&r, infuse iron with &fcarbon&r to get &fenriched iron&r, then infuse that with carbon a second time to get &fsteel dust&r. Smelt the dust into a &bSteel Ingot&r."
		""
		"Steel is the backbone of every Mekanism machine. Bring one back."
	]
	quest.6ECA15000000000B.quest_subtitle: "Iron, hardened."
	quest.6ECA15000000000B.title: "Steel"
	quest.6ECA15000000000E.quest_desc: ["A &bSteel Casing&r is the shell every Mekanism machine is built into. Craft one - with casings on hand, the machine line opens up."]
	quest.6ECA15000000000E.quest_subtitle: "Machine shells."
	quest.6ECA15000000000E.title: "Steel Casing"
	quest.6ECA150000000011.quest_desc: [
		"Steel doesn't have to come one infuse at a time. In the &eMetallurgic Infuser&r, infuse a &bBucket of Iron Slime Milk&r with &fcarbon&r (coal or charcoal) and it comes out a &7Steel Slime in a Bucket&r - the same iron-and-carbon trick that makes steel itself."
		""
		"Feed it to a Cave Frog and turn in the &6Steel Froglight&r it leaves. Smelt it for steel, the same metal the infuser makes, now pouring off a frog."
	]
	quest.6ECA150000000011.quest_subtitle: "Steel, the frog way."
	quest.6ECA150000000011.title: "Steel Slime"
	quest.6ECA150000000014.quest_desc: [
		"Up here in the void you're as high as the world goes - and a &eWind Generator&r turns altitude into power. Passive, no fuel, day and night, and the higher it sits the more it makes."
		""
		"Build one (a couple of &fEnergy Tablets&r from the Infuser do most of the work) and let the wind run your machines."
	]
	quest.6ECA150000000014.quest_subtitle: "Free power, breezy."
	quest.6ECA150000000014.title: "Wind Generator"
	quest.6ECA150000000017.quest_desc: ["A furnace burns fuel; the &eEnergized Smelter&r runs on the Joules you already make, and faster. It's also the back half of ore-doubling - dusts in, ingots out."]
	quest.6ECA150000000017.quest_subtitle: "Powered smelting."
	quest.6ECA150000000017.title: "Energized Smelter"
	quest.6ECA15000000001A.quest_desc: [
		"The payoff. The &eEnrichment Chamber&r is Mekanism's ore-doubler - run a metal &6Froglight&r through it and it splits into &btwo dusts&r. Feed those to the Energized Smelter and one froglight becomes &btwo ingots&r."
		""
		"Your frog metals, doubled. (Gems pass through unchanged - only the metals dust.)"
		""
		"For wiring it all together, a &eBuilding Gadget&r to throw up machine rooms in a click."
	]
	quest.6ECA15000000001A.quest_subtitle: "Doubling, electrified."
	quest.6ECA15000000001A.title: "Enrichment Chamber"
	quest.70B0000000000002.quest_desc: [
		"Cave gave you ore, Geode gave you gems and machines - the swamp gives you &aearth itself&r."
		""
		"Prime the &eSpawnery&r with your &dEnriched Diamond&r (plus a slime ball for fuel). Out comes a &2Bottle of Bog Frog Eggs&r - your first swamp frog."
	]
	quest.70B0000000000002.quest_subtitle: "Tier 3 begins."
	quest.70B0000000000002.title: "The Road to Bog"
	quest.70B0000000000005.quest_desc: ["Craft a &2Dirt Slime in a Bucket&r from a bucket of &bdiamond Slime Milk&r - plus four &amossy cobblestone&r, three sweetslime, and your bottle of Bog Frog Eggs. The mossy stone marks the crossover from the mineral tiers into the organic swamp."]
	quest.70B0000000000005.quest_subtitle: "Dirt you can pour."
	quest.70B0000000000005.title: "A Dirt Slime in a Bucket"
	quest.70B0000000000008.quest_desc: ["Run the Dirt Slime through the &eSlime Milker&r for a bucket of &2Dirt Slime Milk&r. Pour it out and Dirt Slimes start spawning on their own."]
	quest.70B0000000000008.quest_subtitle: "Milk the brown."
	quest.70B0000000000008.title: "A Bucket of Dirt Slime Milk"
	quest.70B000000000000B.quest_desc: [
		"Feed Dirt Slimes to your Bog Frog and it drops a &6Dirt Froglight&r. Turn one in - then smelt the rest into dirt, renewable land straight off the frog."
		""
		"The swamp is open. Every organic the bog has is a frog away now."
	]
	quest.70B000000000000B.quest_subtitle: "The Bog's foundation."
	quest.70B000000000000B.title: "Dirt"
	quest.70B000000000000E.quest_desc: [
		"The swamp won't take a raw diamond - it wants it &dEnriched&r."
		""
		"Run a &bdiamond&r through the &eEnrichment Chamber&r (your Geode capstone machine). The Enriched Diamond is the seed for everything Bog."
	]
	quest.70B000000000000E.quest_subtitle: "Crush it for more."
	quest.70B000000000000E.title: "Enrich a Diamond"
	quest.70B0000000000011.quest_desc: [
		"Stone doesn't belong in a swamp - it has to go &amossy&r first."
		""
		"Infuse &7cobblestone&r with &aBiomass&r in the &eMetallurgic Infuser&r (10 mB each). Mossy cobblestone is the organic stand-in for plain stone that seeds the first Bog slime."
	]
	quest.70B0000000000011.quest_subtitle: "Stone goes green."
	quest.70B0000000000011.title: "Mossy Cobblestone"
	quest.70B0000000000014.quest_desc: [
		"Mossy cobblestone starts with &aBio Fuel&r, and Bio Fuel needs a grinder."
		""
		"Craft a &eMekanism Crusher&r. Feed it any plant matter - saplings, leaves, your spare frog-farmed organics - and it grinds them into &aBio Fuel&r."
	]
	quest.70B0000000000014.quest_subtitle: "Grind it down."
	quest.70B0000000000014.title: "The Crusher"
	quest.70B0000000000017.quest_desc: [
		"Run plant matter through the &eCrusher&r to stock up on &aBio Fuel&r - eight to start."
		""
		"The &eMetallurgic Infuser&r drinks Bio Fuel as its &bBiomass&r infusion - that's what turns cobblestone mossy. Keep a supply on hand; the Bog slime chain runs on it."
	]
	quest.70B0000000000017.quest_subtitle: "The swamp's infusion."
	quest.70B0000000000017.title: "Bio Fuel"
	quest.71DE000000000002.quest_desc: [
		"Industrial Foregoing's machines all bolt onto a &eMachine Frame&r, and the humblest is the &ePity Machine Frame&r - logs, iron, and a block of redstone, no plastic required."
		""
		"Craft one. The &bDissolution Chamber&r bolts onto it."
	]
	quest.71DE000000000002.quest_subtitle: "Industrial Foregoing arrives."
	quest.71DE000000000002.title: "The Machine Frame"
	quest.71DE000000000005.quest_desc: [
		"&fLatex&r is the fluid the &bDissolution Chamber&r runs on, and your frogs already make it. Melt a &6plastic Froglight&r in the &eCrucible&r - the same block that bootstrapped your lava - and it renders down into a bucket of &fLiquid Latex&r."
		""
		"No Fluid Extractor, no rubber trees - the plastic frog is the source. Fill a bucket and keep a tank of it for the Chamber."
	]
	quest.71DE000000000005.quest_subtitle: "Melt a plastic Froglight in the Crucible."
	quest.71DE000000000005.title: "A Bucket of Latex"
	quest.71DE000000000008.quest_desc: [
		"Industrial Foregoing's &eDissolution Chamber&r dissolves a pile of items in a fluid and presses out something new. Frame it with &fplastic&r (your &bplastic slime&r supplies it), feed it the &flatex&r you rendered from a plastic Froglight, and it becomes the pack's &eslime engine&r."
		""
		"Every resource slime has a chamber recipe. &eCave&r, &eGeode&r, &eBog&r, and now &eTide&r each take a prior resource, tier filler, sweetslime, and latex, and press out that variant's &bSlime in a Bucket&r. Check JEI for whichever you need. Cave, Geode, and Bog still have hand-craft chains too; from &eTide&r on, the chamber is the only way."
		""
		"This chapter, the &eRoad to Tide&r, is the bridge that closes out &eBog&r and opens &eTide&r. Below, you'll prime your first &bTide Frog&r and draw a &6Prismarine Froglight&r out of the sea."
		""
		"Claim your reward. The engine is online."
	]
	quest.71DE000000000008.quest_subtitle: "The Dissolution Chamber."
	quest.71DE000000000008.title: "The Slime Engine"
	quest.71DE00000000000E.quest_desc: [
		"You closed out &eBog&r with &bpink slime&r - it's also your key to the sea. Feed &bpink slime&r to the &eSpawnery&r to prime it for &eTide&r, and it bottles a &bBottle of Tide Frog Eggs&r."
		""
		"Pour it on water. &eTide Frogs&r hatch: the aquatic species, hungry for sponge, prismarine, and ink."
	]
	quest.71DE00000000000E.quest_subtitle: "Prime for the sea."
	quest.71DE00000000000E.title: "Tide Frog Eggs"
	quest.71DE000000000014.quest_desc: [
		"From here on, the &eDissolution Chamber&r is the only way to make resource slimes - no more crafting-table chains. Feed it &fpink slime&r + &fmycelium&r + &fsweetslime&r and &flatex&r, and it presses out a &bBucket of Prismarine Slime&r, your first aquatic resource slime."
		""
		"&eTide&r and every tier after it runs on the chamber."
	]
	quest.71DE000000000014.quest_subtitle: "The ocean in a bucket."
	quest.71DE000000000014.title: "A Bucket of Prismarine Slime"
	quest.71DE000000000017.quest_desc: [
		"Run the &bPrismarine Slime&r through a &eSlime Milker&r for &bPrismarine Slime Milk&r."
		""
		"Place the milk and prismarine slimes spawn for your &eTide Frog&r to eat."
	]
	quest.71DE000000000017.quest_subtitle: "Prismarine Slime Milk."
	quest.71DE000000000017.title: "Milk It"
	quest.71DE00000000001A.quest_desc: [
		"Feed a prismarine slime to a &eTide Frog&r and it drops a &6Prismarine Froglight&r. Smelt it for &fprismarine shards&r: ocean stone, no monument required."
		""
		"&eTide&r is open. The rest of the aquatic chain - crystals, sponge, ink, sea pickle, nautilus - waits in &eDrowned Riches&r."
	]
	quest.71DE00000000001A.quest_subtitle: "Tier 4 opens."
	quest.71DE00000000001A.title: "First Prismarine"
	quest.79D9A7438B1DD129.quest_desc: ["Start by punching wood. Get an oak log from your first tree."]
	quest.79D9A7438B1DD129.quest_subtitle: "Something under your feet."
	quest.79D9A7438B1DD129.title: "Wood to Stand On"
	quest.70E0000000000004.quest_desc: [
		"Powah runs on &edielectric paste&r: three coals, two of your Bog frog's &bclay&r, and a bucket of lava. Every machine in this chapter is built on the stuff."
		""
		"Mash up &a4&r."
	]
	quest.70E0000000000004.quest_subtitle: "The clay gate."
	quest.70E0000000000004.title: "Dielectric Paste"
	quest.70E0000000000007.quest_desc: [
		"Paste, a tiny capacitor, a casing, and a plain furnace build the &eFurnator&r - Powah's starter generator. Feed it anything that burns; your Coal frog keeps it stocked."
		""
		"Mekanism's Heat Generator got you here. This chapter is the scaling arc."
	]
	quest.70E0000000000007.quest_subtitle: "A furnace that makes FE instead of food."
	quest.70E0000000000007.title: "The Furnator"
	quest.70E000000000000B.quest_desc: [
		"An &eEnergy Cell&r buffers the Furnator's output so machines sip instead of starve."
		""
		"Cable runs come next - the reward helps you hide them inside any block you like."
	]
	quest.70E000000000000B.quest_subtitle: "Store it before you spill it."
	quest.70E000000000000B.title: "Bottled Lightning"
	quest.70E000000000000E.quest_desc: [
		"The &eEnergizing Orb&r crafts by burning raw FE: ring it with &eEnergizing Rods&r, give it power, drop materials in. Everything above starter tier comes through this thing."
	]
	quest.70E000000000000E.quest_subtitle: "Crafting, but with voltage."
	quest.70E000000000000E.title: "The Energizing Orb"
	quest.70E0000000000011.quest_desc: [
		"Orb &firon&r and &6gold&r into &eEnergized Steel&r - then the pack's law kicks in: &amake a resource yourself once, and the Dissolution Chamber will slime it&r. Chamber a steel into an Energized Steel Slime, feed a Cave frog, and never orb it by hand again."
		""
		"Turn in the &6Energized Steel Froglight&r."
	]
	quest.70E0000000000011.quest_subtitle: "Iron and gold walk into an orb."
	quest.70E0000000000011.title: "Energized Steel"
	quest.70E0000000000014.quest_desc: [
		"No uraninite ore on a void skyblock - but the Orb presses &buraninite&r from &buranium ingots&r. Uranium has no ore here either; it sits near the end of the &aAll the Ores seed chain&r (osmium milk onward, same milk-and-eggs craft as the Cave metals), so raise a &aUranium frog&r and feed the Orb its harvest. A &aUraninite Slime&r can also turn up from a Cave frog's split, but one slime, however you get it, is all the chamber needs to scale the farm."
		""
		"Turn in the &6Uraninite Froglight&r."
	]
	quest.70E0000000000014.quest_subtitle: "The frog is the uranium mine."
	quest.70E0000000000014.title: "Uraninite"
	quest.70E0000000000017.quest_desc: [
		"Powah's coolant - reactors and thermo setups want it cold. The Orb presses &bDry Ice&r from two &bblue ice&r - and blue ice is just 81 of your &bIce frog's&r produce, packed twice. (The Tide pool can also roll a Dry Ice Slime by split-discovery, if the frogs beat you to it.)"
		""
		"Turn in the &6Dry Ice Froglight&r."
	]
	quest.70E0000000000017.quest_subtitle: "Cold storage."
	quest.70E0000000000017.title: "Dry Ice"
	quest.70E000000000001A.quest_desc: [
		"The Orb wants &cblaze powder&r - four of it - for a &cBlazing Crystal&r. Your Infernal frog makes the rods; each rod cracks into two powder. Make a crystal yourself, chamber it, frog it."
		""
		"Turn in the &6Blazing Froglight&r."
	]
	quest.70E000000000001A.quest_subtitle: "Powder in, crystal out."
	quest.70E000000000001A.title: "Blazing Crystal"
	quest.70E000000000001D.quest_desc: [
		"Orbed from &bdiamonds&r - the crystal half is Geode-easy. The slime half rides a &5Void frog&r, so the farm waits for Tier 6."
		""
		"Turn in the &6Niotic Froglight&r."
	]
	quest.70E000000000001D.quest_subtitle: "Diamonds, energized."
	quest.70E000000000001D.title: "Niotic Crystal"
	quest.70E0000000000020.quest_desc: [
		"Orbed from &aemeralds&r - the second-highest rung on the ladder. Like Niotic, the slime is &5Void frog&r business."
		""
		"Turn in the &6Spirited Froglight&r."
	]
	quest.70E0000000000020.quest_subtitle: "Emeralds with a work ethic."
	quest.70E0000000000020.title: "Spirited Crystal"
	quest.70E0000000000023.quest_desc: [
		"The top of Powah's ladder - and the Orb prices it accordingly: a &enether star&r (yes, that star), two redstone blocks, and a block of Blazing Crystal. Nitro machines outpace everything below by an order of magnitude; the slime, as ever up here, rides a &5Void frog&r."
		""
		"Turn in the &6Nitro Froglight&r."
	]
	quest.70E0000000000023.quest_subtitle: "Handle with tongs."
	quest.70E0000000000023.title: "Nitro Crystal"
	quest.70E0000000000026.quest_desc: [
		"The &eReactor&r is a multiblock that sips &auraninite&r and pays out more FE than everything else in this chapter combined. Your uraninite frogs have been waiting for this."
		""
		"Build a &eStarter Reactor&r."
	]
	quest.70E0000000000026.quest_subtitle: "Serious FE."
	quest.70E0000000000026.title: "The Uraninite Reactor"
	quest.70E0000000000029.quest_desc: [
		"&dFlux Dust&r is born in a ritual: &credstone&r thrown onto &8obsidian&r that rests on &8bedrock&r. And yes - islands born in this era of the pack HAVE bedrock: one block at bottom-center, the heart the platform was built around. Dig down at spawn and see."
		""
		"Set obsidian on the heart, toss redstone on top, then &epunch the obsidian&r (left-click) to compress it into dust. Once you own a &dFlux Block&r, that works as the anvil too. No heart handy? A crafting grid presses one dust from &credstone&r sandwiched between two &8obsidian&r."
		""
		"The first dust primes your Infernal frog for the rest. Make &a4&r."
	]
	quest.70E0000000000029.quest_subtitle: "Your island kept a secret."
	quest.70E0000000000029.title: "Flux Dust"
	quest.70E000000000002C.quest_desc: [
		"You made the dust yourself, so the chamber law is satisfied: slime it, feed the &cInfernal frog&r, and flux becomes a farm."
		""
		"Turn in the &6Flux Dust Froglight&r."
	]
	quest.70E000000000002C.quest_subtitle: "The frog does wireless too."
	quest.70E000000000002C.title: "Flux on Tap"
	quest.70E0000000000031.quest_desc: [
		"A &dFlux Controller&r runs the network, a &dPlug&r drinks FE in, a &dPoint&r pours it out - anywhere, any dimension, no cables. Your Reactor on one island, your machines on every other."
		""
		"Build all three."
	]
	quest.70E0000000000031.quest_subtitle: "Power without wires."
	quest.70E0000000000031.title: "The Network Is Live"
	quest.7B06000000000002.quest_desc: [
		"The Bog frog eats more than dirt. Each new resource threads off the &elast one's Slime Milk&r - mud from dirt, clay from mud, on down the swamp."
		""
		"The loop never changes: prior milk + four mossy cobblestone + three sweetslime + a bottle of Bog Frog Eggs -> the next Slime in a Bucket. Milk it, feed the frog, and it drops the &6Froglight&r."
		""
		"Every quest here wants that &6Froglight&r - the frog's own proof - so hand one in before you smelt it into the resource."
	]
	quest.7B06000000000002.quest_subtitle: "The Bog chain opens."
	quest.7B06000000000002.title: "Beyond Dirt"
	quest.7B06000000000005.quest_desc: ["Craft a &bMud Slime in a Bucket&r, feed your &aBog Frog&r, and turn in the &6Mud Froglight&r."]
	quest.7B06000000000005.quest_subtitle: "Squelch."
	quest.7B06000000000005.title: "Mud"
	quest.7B06000000000008.quest_desc: ["Craft a &bClay Slime in a Bucket&r, feed your &aBog Frog&r, and turn in the &6Clay Froglight&r."]
	quest.7B06000000000008.quest_subtitle: "Bricks in waiting."
	quest.7B06000000000008.title: "Clay"
	quest.7B0600000000000B.quest_desc: ["Craft a &bMoss Slime in a Bucket&r, feed your &aBog Frog&r, and turn in the &6Moss Froglight&r."]
	quest.7B0600000000000B.quest_subtitle: "Soft and spreading."
	quest.7B0600000000000B.title: "Moss"
	quest.7B0600000000000E.quest_desc: ["Craft a &bMycelium Slime in a Bucket&r, feed your &aBog Frog&r, and turn in the &6Mycelium Froglight&r."]
	quest.7B0600000000000E.quest_subtitle: "Mushroom ground."
	quest.7B0600000000000E.title: "Mycelium"
	quest.7B06000000000011.quest_desc: ["Craft a &bLily Pad Slime in a Bucket&r, feed your &aBog Frog&r, and turn in the &6Lily Pad Froglight&r."]
	quest.7B06000000000011.quest_subtitle: "A frog's favorite seat."
	quest.7B06000000000011.title: "Lily Pad"
	quest.7B06000000000034.quest_desc: [
		"Tired of leashing frogs to keep them in place? Right-click a placed &alily pad&r with a &dSweetslime&r and it becomes a &aSweetslimed Lily Pad&r."
		""
		"The nearest frog walks over and settles on it - one frog per pad. It keeps eating same-species slimes in range and dropping &6Froglights&r right there, so park one over a hopper beside a &eSlime Milk&r source for hands-off collection. Break the pad to free the frog."
		""
		"Make one, then check this off. (Your &9field guide&r has the full page.)"
	]
	quest.7B06000000000034.quest_subtitle: "Pin a frog, no leash."
	quest.7B06000000000034.title: "A Frog Perch"
	quest.7B06000000000014.quest_desc: ["Craft a &bLeather Slime in a Bucket&r, feed your &aBog Frog&r, and turn in the &6Leather Froglight&r."]
	quest.7B06000000000014.quest_subtitle: "No cow needed."
	quest.7B06000000000014.title: "Leather"
	quest.7B06000000000017.quest_desc: ["Craft a &bFeather Slime in a Bucket&r, feed your &aBog Frog&r, and turn in the &6Feather Froglight&r."]
	quest.7B06000000000017.quest_subtitle: "No chicken either."
	quest.7B06000000000017.title: "Feather"
	quest.7B0600000000001A.quest_desc: [
		"The swamp turns synthetic. &fPlastic&r from your &elily pad milk&r - and since the &cnormal latex-to-plastic recipe is gone&r, this frog is now the &lonly&r source of plastic in the pack."
		""
		"Plastic is the key to &eIndustrial Foregoing&r - most of its machines need it - so the bog just became mandatory tech."
	]
	quest.7B0600000000001A.quest_subtitle: "Slime, refined."
	quest.7B0600000000001A.title: "Plastic"
	quest.7B0600000000001D.quest_desc: [
		"The apex of the swamp: &dPink Slime&r from your &eplastic milk&r - Industrial Foregoing's living synthetic."
		""
		"You've arrived. Take a full set of machine tuning - &bSpeed&r, &aEfficiency&r, and &eProcessing&r addons (tier 2) - and put your IF line into overdrive."
	]
	quest.7B0600000000001D.quest_subtitle: "The Bog's prize."
	quest.7B0600000000001D.title: "Pink Slime"
