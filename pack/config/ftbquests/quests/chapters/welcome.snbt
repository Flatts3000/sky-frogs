		{
			id: "B2C3D4E5F6A10011"
			title: "Silkworms"
			dependencies: ["B2C3D4E5F6A10001"]
			x: -6.0d
			y: 7.5d
			description: [
				"Crook your leaves until a Silkworm drops, then set it loose on a leaf block. It chews its way outward, infesting the leaves around it."
				""
				"Infested leaves are where your string comes from."
			]
			tasks: [{ id: "B2C3D4E5F6A10012", item: { count: 1, id: "exdeorum:silkworm" }, type: "item" }]
			rewards: [{ count: 4, id: "B2C3D4E5F6A10013", item: { count: 1, id: "exdeorum:cooked_silkworm" }, type: "item" }]
