			dependencies: ["C3D4E5F6A1B20001"]
			x: 3.0d
			y: 7.5d
			description: [
				"Water and lava, one block apart, make cobble forever. You spawned with a bucket of each - set up the generator and chip off a stack."
				""
				"Then take the &eIron Hammer&r. It turns grey rock into other, more useful grey rock."
			]
			tasks: [{ count: 16L, id: "C3D4E5F6A1B20012", item: { count: 1, id: "minecraft:cobblestone" }, type: "item" }]
