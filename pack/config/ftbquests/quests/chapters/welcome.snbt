		{
			id: "D4E5F6A1B2C30011"
			title: "A Composter"
			icon: { id: "minecraft:composter" }
			dependencies: ["D4E5F6A1B2C30001"]
			x: 0.0d
			y: 7.5d
			description: [
				"A &acomposter&r is seven wooden slabs in a U. Feed it the overflow from your tree farm - spare saplings, leaves, seeds - and it pays you back in &ebone meal&r."
				""
				"Bone meal is worth hoarding. It forces crops and saplings up on command, and you'll have a use for it before long."
			]
			tasks: [
				{ id: "D4E5F6A1B2C30012", item: { count: 1, id: "minecraft:composter" }, type: "item" }
