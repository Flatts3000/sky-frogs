		{
			id: "C3D4E5F6A1B20001"
			title: "Tools of the Trade"
			dependencies: ["F9D9A7438B1DD129"]
			x: 3.0d
			y: 6.0d
			description: ["A wooden pickaxe: three planks, two sticks. It's the one mining tool you'll bother crafting - strictly for cobble. The frogs cover everything else."]
			tasks: [{ id: "C3D4E5F6A1B20002", item: { count: 1, id: "minecraft:wooden_pickaxe" }, type: "item" }]
