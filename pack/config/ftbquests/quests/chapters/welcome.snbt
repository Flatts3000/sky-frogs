			]
		}
		{
			id: "A1B2C3D4E5F60001"
			title: "A Rain Barrel"
			dependencies: ["F9D9A7438B1DD129"]
			x: -3.0d
			y: 6.0d
			description: ["Craft an Oak Barrel and leave it out in the weather. It catches rain - which, on an island with one bucket of water, is the start of having two."]
			tasks: [{ id: "A1B2C3D4E5F60002", item: { count: 1, id: "exdeorum:oak_barrel" }, type: "item" }]
			rewards: [{ id: "A1B2C3D4E5F60003", item: { count: 1, id: "minecraft:shears" }, type: "item" }]
		}
		{
			id: "A1B2C3D4E5F60011"
			title: "Strip the Leaves"
			dependencies: ["A1B2C3D4E5F60001"]
			x: -3.0d
			y: 7.5d
			description: [
				"Those shears aren't for sheep. Run them across your oak leaves and the leaves come off as whole blocks - the one thing an Oak Crucible knows how to drink."
				""
				"Shear a stack."
			]
			tasks: [{ count: 16L, id: "A1B2C3D4E5F60012", item: { count: 1, id: "minecraft:oak_leaves" }, type: "item" }]
			rewards: [{ count: 16, id: "A1B2C3D4E5F60013", item: { count: 1, id: "minecraft:torch" }, type: "item" }]
		}
		{
			id: "A1B2C3D4E5F60021"
			title: "The Crucible"
			dependencies: ["A1B2C3D4E5F60011"]
			x: -3.0d
			y: 9.0d
			description: [
				"Build an Oak Crucible and prop a torch beneath it. Drop your leaves in; the heat slowly wrings them out into water."
				""
				"Slow, free, and entirely yours."
			]
			tasks: [{ id: "A1B2C3D4E5F60022", item: { count: 1, id: "exdeorum:oak_crucible" }, type: "item" }]
			rewards: [{ count: 4, id: "A1B2C3D4E5F60023", item: { count: 1, id: "farmersdelight:vegetable_soup" }, type: "item" }]
		}
		{
			id: "A1B2C3D4E5F60031"
			title: "Running Water"
			dependencies: ["A1B2C3D4E5F60021"]
			x: -3.0d
			y: 10.5d
			description: [
				"Two water sources one block apart make an infinite one - scoop from the middle forever."
				""
				"You've got your spawn bucket and a barrel (or a crucible) working on the second. Set them side by side and never ration water again."
			]
			tasks: [{ id: "A1B2C3D4E5F60032", type: "checkmark" }]
			rewards: [{ id: "A1B2C3D4E5F60033", type: "xp", xp: 15 }]
		}
		{
			id: "B2C3D4E5F6A10001"
			title: "A Crook"
			dependencies: ["F9D9A7438B1DD129"]
			x: -6.0d
			y: 6.0d
			description: ["Two sticks make a Crook. Drag it across oak leaves and they give up far more than bare hands would - saplings to replant, and now and then a wriggling &eSilkworm&r."]
			tasks: [{ id: "B2C3D4E5F6A10002", item: { count: 1, id: "exdeorum:crook" }, type: "item" }]
			rewards: [{ count: 4, id: "B2C3D4E5F6A10003", item: { count: 1, id: "farmersdelight:vegetable_soup" }, type: "item" }]
