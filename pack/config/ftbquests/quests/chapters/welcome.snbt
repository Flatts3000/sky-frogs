		}
		{
			id: "D4E5F6A1B2C30031"
			title: "Synthesize Life"
			icon: { id: "productivefrogs:cave_frog_egg" }
			dependencies: ["D4E5F6A1B2C30021"]
			x: 0.0d
			y: 10.5d
			description: [
				"&aPrime the Spawnery with cobblestone&r - that's the Cave frog's calling card - drop in a slime ball to burn, and seat a glass bottle."
				""
				"Out comes a &eBottle of Cave Frog Frogspawn&r. Make &btwo&r: two frogs is a breeding pair, and a breeding pair is a farm that never runs dry."
				""
				"That's the last thing you'll build by hand for a while. Tip them onto water and let the frogs take over."
