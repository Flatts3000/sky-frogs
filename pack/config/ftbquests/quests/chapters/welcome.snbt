	title: "Welcome"
	quests: [
		{
			id: "01A8E068925B319F"
			title: "Welcome to Sky Frogs"
			icon: { id: "productivefrogs:cave_frog_egg" }
			x: 0.0d
			y: 0.0d
			shape: "hexagon"
			size: 1.5d
			description: [
				"You're stranded on a speck of dirt in the void. No ore, no mineshafts, not so much as a mountain to feel bad about."
				""
				"What you've got is &afrogs&r - and out here, that turns out to be the same thing as a mine."
				""
				"This book is the plan. Follow it and you'll never swing a pickaxe at stone again."
			]
			tasks: [{ id: "4296B8F81CE7FD66", type: "checkmark" }]
			rewards: [{ id: "2E6119B4EE9588F7", type: "xp", xp: 10 }]
		}
		{
			id: "05BFA1537298A589"
			title: "Frogs, Not Pickaxes"
			dependencies: ["01A8E068925B319F"]
			x: 0.0d
			y: 1.5d
			description: [
				"Here's the whole trick:"
				""
				"A &bResource Slime&r, fed to its matching &aFrog&r, comes back out as a &eFroglight&r loaded with that resource. Smelt the Froglight, pocket the ingot."
				""
				"Iron, gold, diamond, ender - every one of them is just a frog you haven't met yet."
			]
			tasks: [{ id: "8681547B10F0F5A2", type: "checkmark" }]
			rewards: [{ id: "9501710B6AD1BF8B", type: "xp", xp: 10 }]
		}
		{
			id: "378B93672C31CF5D"
			title: "The Road to Iron"
			dependencies: ["05BFA1537298A589"]
			x: 0.0d
			y: 3.0d
			description: [
				"Your first frog is the &eCave Frog&r. It deals in the things you'd normally swing a pickaxe for: iron, copper, gold, and the rest of the stone-and-ore crowd."
				""
				"Tier 0 is just getting on your feet - water, stone, a dark room, and a slime farm. Then the frogs take over."
				""
				"Let's get you there."
			]
			tasks: [{ id: "15D92B702B5B6338", type: "checkmark" }]
			rewards: [
				{ count: 6, id: "DEA958DB4B72AD0E", item: { count: 1, id: "minecraft:oak_sapling" }, type: "item" }
				{ count: 1, id: "7C4D9E2F1A8B3605", item: { count: 1, id: "minecraft:water_bucket" }, type: "item" }
				{ count: 1, id: "7D5E0F3A2B9C4716", item: { count: 1, id: "minecraft:lava_bucket" }, type: "item" }
			]
		}
		{
			id: "F9D9A7438B1DD129"
			title: "Wood to Stand On"
			dependencies: ["378B93672C31CF5D"]
			x: 0.0d
			y: 4.5d
			description: ["Plant a sapling, grow a tree, punch it. Everything starts with wood - even a frog empire."]
			tasks: [{ id: "8AB98ED63DD877F0", item: { count: 1, id: "minecraft:oak_log" }, type: "item" }]
			rewards: [
				{ count: 1, id: "1A2B3C4D5E6F7081", item: { count: 1, id: "craftingstation:crafting_station" }, type: "item" }
