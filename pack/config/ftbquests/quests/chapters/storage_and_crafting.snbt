			x: 0.0d
			y: 0.0d
			description: [
				"The metal's piling up faster than your chests can hold it. Time for storage that grows with you."
				""
				"A &eSophisticated Barrel&r starts as a plain wooden box - but it takes &fupgrades&r that stack it deeper, pull items in on their own, and pack them down. Craft your first; everything here slots into it."
			]
			tasks: [{ id: "570A6E0000000003", item: { count: 1, id: "sophisticatedstorage:barrel" }, type: "item" }]
			rewards: [{ id: "570A6E0000000004", type: "xp", xp: 10 }]
